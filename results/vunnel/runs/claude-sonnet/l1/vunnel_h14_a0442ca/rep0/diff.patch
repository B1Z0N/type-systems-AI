+def _collapse_arches(entries):
+    """
+    Take (package, version, arch, module) tuples (arch may be None) and return (package, version, module, arch)
+    tuples where arch is only set when the architecture differentiates the fix: a version that is shipped for every
+    architecture seen in the advisory (or that has no architecture at all) is emitted once, without an arch.
+    """
+    all_arches = {arch for _, _, arch, _ in entries if arch}
+    arches_by_fix = {}
+    for pkg, version, arch, module in entries:
+        arches_by_fix.setdefault((pkg, version, module), set()).add(arch)
+
+    results = []
+    for (pkg, version, module), arches in arches_by_fix.items():
+        if None in arches or arches == all_arches:
+            results.append((pkg, version, module, None))
+        else:
+            results.extend((pkg, version, module, arch) for arch in arches)
+    return sorted(results, key=lambda r: (r[0], r[1], r[2] or "", r[3] or ""))
+
