@@ -270,3 +292,27 @@ def _get_all_criterion(element_b, oval_ns, config: Config):
     if final_ns_name:
         collectibles.append([final_ns_name, final_module_name])
     return collectibles
+
+
+def _walk_criteria(element, config: Config, arch):
+    """
+    Yield (criterion element, architecture) for every criterion under the element. The architecture is the one named
+    by an "Oracle Linux arch is X" criterion among the nearest enclosing criteria's direct children (or None).
+    """
+    children = list(element)
+    if config.arch_pattern:
+        for child in children:
+            if _tag(child, config) == "criterion":
+                m = re.search(config.arch_pattern, child.attrib.get("comment", ""))
+                if m:
+                    arch = m.group(1)
+    for child in children:
+        tag = _tag(child, config)
+        if tag == "criterion":
+            yield child, arch
+        elif tag == "criteria":
+            yield from _walk_criteria(child, config, arch)
+
+
+def _tag(element, config: Config) -> str:
+    return re.search(config.tag_pattern, element.tag).group(1)
