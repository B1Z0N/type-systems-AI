+def _resolve_arches(pkgs: set) -> set:
+    """
+    Given (name, version, module, arch) tuples (arch may be None), drop the arch where it does not
+    differentiate the fix: if every version of a package ships for all of the architectures seen for that
+    package, the entries are collapsed to one arch-less entry per version. Otherwise (name, version, arch)
+    entries are kept.
+    """
+    by_pkg: dict = {}
+    for name, version, module, arch in pkgs:
+        by_pkg.setdefault((name, module), {}).setdefault(version, set()).add(arch)
+
+    resolved = set()
+    for (name, module), versions in by_pkg.items():
+        all_arches = set().union(*versions.values())
+        if None in all_arches or all(arches == all_arches for arches in versions.values()):
+            resolved.update((name, version, module, None) for version in versions)
+        else:
+            resolved.update((name, version, module, arch) for version, arches in versions.items() for arch in arches)
+    return resolved
+
+
+def _walk_criteria(element, oval_ns, config: Config, arch, collectibles: list):
+    # an arch criterion applies to everything within the criteria element that contains it
+    for criterion in element.iterfind(config.criterion_xpath_query.replace(".//", "").format(oval_ns)):
+        m = re.search(config.arch_pattern, criterion.attrib["comment"]) if config.arch_pattern else None
+        if m:
+            arch = m.group(1)
+
+    for child in element:
+        if child.tag == f"{oval_ns}criteria":
+            _walk_criteria(child, oval_ns, config, arch, collectibles)
+        elif child.tag == f"{oval_ns}criterion":
+            comment = child.attrib["comment"]
+            if config.arch_pattern and re.search(config.arch_pattern, comment):
+                continue
+            m = re.search(config.pkg_version_pattern, comment)
+            if m:
+                collectibles.append((m.group(1), m.group(2), arch))
+
+
