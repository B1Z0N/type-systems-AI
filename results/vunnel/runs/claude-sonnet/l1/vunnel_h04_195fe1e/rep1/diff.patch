+        "published": "2019-11-05T23:30:00-02:00",
+        "affected": [
+            {
+                "package": {"ecosystem": "AlmaLinux:8", "name": "lua"},
+                "ranges": [{"type": "ECOSYSTEM", "events": [{"introduced": "0"}, {"fixed": "5.3.4-11.el8"}]}],
+            }
+        ],
+    }
+    _, _, record = parser._normalize(entry, "8")
