+    @staticmethod
+    def _published_date(published: str | None) -> str | None:
+        if not published:
+            return None
+        try:
+            parsed = datetime.datetime.fromisoformat(published.strip().replace("Z", "+00:00"))
+        except ValueError:
+            return None
+        if parsed.tzinfo is not None:
+            parsed = parsed.astimezone(datetime.UTC)
+        return parsed.date().isoformat()
+
+    def _add_fix_dates(self, vuln_entry: dict[str, Any]) -> None:
+        """Record the advisory's published date (UTC) as the fix date of every fixed event."""
+        date = self._published_date(vuln_entry.get("published"))
+        if not date:
+            return
+
+        for affected in vuln_entry.get("affected", []):
+            for range_data in affected.get("ranges", []):
+                fixes = [
+                    {"version": event["fixed"], "date": date, "kind": "advisory"}
+                    for event in range_data.get("events", [])
+                    if event.get("fixed")
+                ]
+                if fixes:
+                    db_spec = range_data.setdefault("database_specific", {})
+                    db_spec["anchore"] = {"fixes": fixes}
+
