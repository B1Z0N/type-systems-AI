     p.update(None)
 
     workspace.assert_result_snapshots()
+
+
+def test_parse_arch(tmpdir, helpers):
+    subject = parser.Parser(workspace=workspace.Workspace(tmpdir, "test", create=True))
+    vuln_dict = subject._parse_oval_data(helpers.local_dir("test-fixtures/mock_arch_data"), subject.config)
+
+    def fixed(vuln_id):
+        return {
+            (f["Name"], f["Version"], f.get("Arch"))
+            for f in vuln_dict[(vuln_id, "ol:7")][1]["Vulnerability"]["FixedIn"]
+        }
+
+    fixed_in = vuln_dict[("ELSA-2022-4803", "ol:7")][1]["Vulnerability"]["FixedIn"]
+    assert len(fixed_in) == 2
+
+    # the fix differs by architecture: one entry per (version, arch)
+    assert fixed("ELSA-2022-4803") == {
+        ("rsyslog", "0:8.24.0-57.0.4.el7_9.3", "aarch64"),
+        ("rsyslog", "0:8.24.0-57.0.1.el7_9.3", "x86_64"),
+    }
+    # one fix shared by all arches: single arch-less entry
+    assert fixed("ELSA-2022-0001") == {("foo", "0:1.0-1.el7", None)}
+    # several rebuilds all shipped for every arch: one arch-less entry per version
+    assert fixed("ELSA-2022-0002") == {("bar", "0:1.0-1.el7", None), ("bar", "0:1.0-2.el7", None)}
+    assert all("Arch" not in f for f in vuln_dict[("ELSA-2022-0002", "ol:7")][1]["Vulnerability"]["FixedIn"])
