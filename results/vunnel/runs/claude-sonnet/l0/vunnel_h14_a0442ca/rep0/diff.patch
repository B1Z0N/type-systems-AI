+def _collapse_arches(entries):
+    """
+    Given a set of (package, version, module, arch) tuples, drop the architecture wherever it does not
+    differentiate the fix. For each (package, module): if every architecture reports the same set of
+    versions (one shared fix, or several rebuilds each shipping everywhere) emit one arch-less entry per
+    version; otherwise keep one entry per (version, architecture).
+    """
+    all_arches = {e[3] for e in entries if e[3]}
+    by_pkg = {}
+    for name, version, module, arch in entries:
+        by_pkg.setdefault((name, module), {}).setdefault(arch, set()).add(version)
+
+    result = set()
+    for (name, module), arch_versions in by_pkg.items():
+        version_sets = list(arch_versions.values())
+        uniform = all(v == version_sets[0] for v in version_sets) and (
+            None in arch_versions or set(arch_versions) == all_arches
+        )
+        if uniform:
+            for version in version_sets[0]:
+                result.add((name, version, module, None))
+        else:
+            for arch, versions in arch_versions.items():
+                for version in versions:
+                    result.add((name, version, module, arch))
+    return result
+
+
+def _collect_pkgs(element, config, inherited_arch=None):
+    """
+    Recursively collect (package, version, arch) tuples under a criteria element. An architecture criterion
+    applies to its sibling criteria (and everything nested beneath them).
+    """
+    arch = inherited_arch
+    if config.arch_pattern:
+        for child in element:
+            if re.search(config.tag_pattern, child.tag).group(1) != "criterion":
+                continue
+            m = re.search(config.arch_pattern, child.attrib.get("comment", ""))
+            if m:
+                arch = m.group(1)
+
+    found = []
+    for child in element:
+        tag = re.search(config.tag_pattern, child.tag).group(1)
+        if tag == "criterion":
+            m = re.search(config.pkg_version_pattern, child.attrib["comment"])
+            if m:
+                found.append((*m.groups(), arch))
+        elif tag == "criteria":
+            found.extend(_collect_pkgs(child, config, arch))
+    return found
+
+
