@@ -12,6 +12,21 @@ from vunnel.utils import date, vulnerability
 from vunnel.utils import http_wrapper as http
 
 
+DEFAULT_VERSION_MARKERS = {"pypi": "+cgr.", "maven": ".cgr.", "npm": "-cgr.", "golang": "-cgr."}
+
+
+def normalize_version_markers(markers):
+    """
+    Validate a purl type -> marker map, dropping ecosystems disabled with a null marker.
+    """
+    if not isinstance(markers, dict):
+        raise ValueError(f"version_markers must be a map of purl type to version marker, got {type(markers).__name__}")
+    bad = [k for k, v in markers.items() if v is not None and (not isinstance(v, str) or v == "")]
+    if bad:
+        raise ValueError(f"empty version marker for {sorted(bad, key=str)}")
+    return {k: v for k, v in markers.items() if v is not None}
+
+
