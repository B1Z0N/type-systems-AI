+def _collapse_arches(entries) -> list[tuple]:
+    """
+    Given (package, version, arch, module) tuples, drop the arch from any fix that is shared by every
+    architecture mentioned in the advisory, and keep it where the architecture differentiates the fix.
+    """
+    all_arches = {e[2] for e in entries if e[2]}
+    by_fix: dict[tuple, set[str]] = {}
+    for pkg, version, arch, module in entries:
+        by_fix.setdefault((pkg, version, module), set())
+        if arch:
+            by_fix[(pkg, version, module)].add(arch)
+
+    collapsed = []
+    for (pkg, version, module), arches in by_fix.items():
+        if not arches or (len(all_arches) > 1 and arches == all_arches):
+            collapsed.append((pkg, version, None, module))
+        else:
+            collapsed.extend((pkg, version, arch, module) for arch in sorted(arches))
+    return sorted(collapsed, key=lambda t: (t[0], t[1], t[2] or "", t[3] or ""))
+
