+def test_architecture_specific_fixes(arch_versions, expected):
+    ns = "http://oval.mitre.org/XMLSchema/oval-definitions-5"
+    root = ET.Element(f"{{{ns}}}definition")
+    criteria = ET.SubElement(root, f"{{{ns}}}criteria", operator="AND")
+    ET.SubElement(criteria, f"{{{ns}}}criterion", comment="Oracle Linux 7 is installed")
+    branches = ET.SubElement(criteria, f"{{{ns}}}criteria", operator="OR")
+    for arch, versions in arch_versions.items():
+        branch = ET.SubElement(branches, f"{{{ns}}}criteria", operator="AND")
+        ET.SubElement(branch, f"{{{ns}}}criterion", comment=f"Oracle Linux arch is {arch}")
+        packages = ET.SubElement(branch, f"{{{ns}}}criteria", operator="OR")
+        for version in versions:
+            ET.SubElement(packages, f"{{{ns}}}criterion", comment=f"rsyslog is earlier than {version}")
+
+    assert _process_criteria(root, f"{{{ns}}}", parser.ol_config) == {"ol:7": expected}
+
