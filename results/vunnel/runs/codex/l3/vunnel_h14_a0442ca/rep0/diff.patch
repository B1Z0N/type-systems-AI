+        "Metadata": {
+          "type": "object",
+          "properties": {
+            "Issued": {
+              "type": "string",
+              "description": "date the vulnerability was published"
+            },
+            "Updated": {
+              "type": "string",
+              "description": "date the vulnerability was last updated"
+            },
+            "Withdrawn": {
+              "type": "string",
+              "description": "date the vulnerability was withdrawn"
+            },
+            "RefId": {
+              "type": "string"
+            },
+            "CVE": {
+              "type": "array",
+              "items": [
+                {
+                  "type": "object",
+                  "properties": {
+                    "Name": {
+                      "type": "string"
+                    },
+                    "Link": {
+                      "type": "string"
+                    }
+                  },
+                  "required": [
+                    "Name"
+                  ]
+                }
+              ]
+            },
+            "NVD": {
+              "type": "object",
+              "properties": {
+                "CVSSv2": {
+                  "type": "object",
+                  "properties": {
+                    "Score": {
+                      "type": "number"
+                    },
+                    "Vectors": {
+                      "type": "string"
+                    }
+                  },
+                  "required": [
+                    "Score"
+                  ]
+                }
+              }
+            }
+          }
+        },
+        "Name": {
+          "type": "string"
+        },
+        "NamespaceName": {
+          "type": "string"
+        },
+        "Severity": {
+          "type": "string"
+        }
+      },
+      "required": [
