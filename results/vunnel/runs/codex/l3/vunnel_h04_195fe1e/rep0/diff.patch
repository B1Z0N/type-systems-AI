+    @staticmethod
+    def _add_fix_dates(vuln_entry: dict[str, Any]) -> None:
+        published = vuln_entry.get("published")
+        if not published:
+            return
+        published_at = datetime.fromisoformat(published.replace("Z", "+00:00"))
+        if published_at.tzinfo is None:
+            published_at = published_at.replace(tzinfo=timezone.utc)
+        fix_date = published_at.astimezone(timezone.utc).date().isoformat()
+
+        for affected in vuln_entry.get("affected", []):
+            for affected_range in affected.get("ranges", []):
+                fixes = [
+                    {"version": event["fixed"], "date": fix_date, "kind": "advisory"}
+                    for event in affected_range.get("events", [])
+                    if event.get("fixed")
+                ]
+                if fixes:
+                    affected_range.setdefault("database_specific", {}).setdefault("anchore", {})["fixes"] = fixes
+
