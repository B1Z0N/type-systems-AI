diff --git a/tests/unit/test_provider_registration.py b/tests/unit/test_provider_registration.py
new file mode 100644
index 0000000..a3bd574
--- /dev/null
+++ b/tests/unit/test_provider_registration.py
@@ -0,0 +1,90 @@
+import pytest
+
+from vunnel import providers
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (None, "FAIL"),
+        ("", "FAIL"),
+        ("unknown", "FAIL"),
+        ("fail", "FAIL"),
+        ("RePlAcE", "REPLACE"),
+        ("IGNORE", "IGNORE"),
+    ],
+)
+def test_plugin_override_mode_from_env(monkeypatch, value, expected):
+    if value is None:
+        monkeypatch.delenv("VUNNEL_PLUGIN_OVERRIDE_MODE", raising=False)
+    else:
+        monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", value)
+
+    assert providers.PluginOverrideMode.from_env().name == expected
+
+
+@pytest.mark.parametrize(("mode", "expected"), [("REPLACE", "new"), ("IGNORE", "original")])
+def test_register_collision_with_explicit_mode(monkeypatch, mode, expected):
+    original = providers.provider_class("alpine")
+    replacement = type("Replacement", (), {})
+    monkeypatch.setattr(providers, "_providers", providers._providers.copy())
+
+    providers.register("alpine", replacement, mode=getattr(providers.PluginOverrideMode, mode))
+
+    assert providers.provider_class("alpine") is (replacement if expected == "new" else original)
+
+
+def test_register_collision_fails_by_default(monkeypatch):
+    original = providers.provider_class("alpine")
+    replacement = type("Replacement", (), {})
+    monkeypatch.setattr(providers, "_providers", providers._providers.copy())
+    monkeypatch.delenv("VUNNEL_PLUGIN_OVERRIDE_MODE", raising=False)
+
+    with pytest.raises(KeyError):
+        providers.register("alpine", replacement)
+
+    assert providers.provider_class("alpine") is original
+
+
+def test_explicit_mode_overrides_environment(monkeypatch):
+    original = providers.provider_class("alpine")
+    replacement = type("Replacement", (), {})
+    monkeypatch.setattr(providers, "_providers", providers._providers.copy())
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "replace")
+
+    with pytest.raises(KeyError):
+        providers.register("alpine", replacement, mode=providers.PluginOverrideMode.FAIL)
+
+    assert providers.provider_class("alpine") is original
+
+
+def test_register_reads_environment_at_each_call(monkeypatch):
+    original = providers.provider_class("alpine")
+    replacement = type("Replacement", (), {})
+    monkeypatch.setattr(providers, "_providers", providers._providers.copy())
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "ignore")
+    providers.register("alpine", replacement)
+    assert providers.provider_class("alpine") is original
+
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "replace")
+    providers.register("alpine", replacement)
+    assert providers.provider_class("alpine") is replacement
+
+
+@pytest.mark.parametrize("mode", ["FAIL", "REPLACE", "IGNORE"])
+def test_register_new_name_in_every_mode(monkeypatch, mode):
+    replacement = type("Replacement", (), {})
+    monkeypatch.setattr(providers, "_providers", providers._providers.copy())
+
+    providers.register("new-plugin", replacement, mode=getattr(providers.PluginOverrideMode, mode))
+
+    assert providers.provider_class("new-plugin") is replacement
+
+
+def test_register_same_class_does_not_collide(monkeypatch):
+    original = providers.provider_class("alpine")
+    monkeypatch.setattr(providers, "_providers", providers._providers.copy())
+
+    providers.register("alpine", original, mode=providers.PluginOverrideMode.FAIL)
+
+    assert providers.provider_class("alpine") is original
