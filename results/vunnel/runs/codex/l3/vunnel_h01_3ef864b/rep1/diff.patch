 import pytest
+import yaml
+from click.testing import CliRunner
 from vunnel import provider, providers, result
 from vunnel.cli import config
+from vunnel.cli.cli import cli
+
+
+def test_chainguard_libraries_version_markers_merge_and_disable(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: '+custom.'\n      maven: null\n")
+
+    markers = config.load(str(path)).providers.chainguard_libraries.version_markers
+
+    assert markers == {"pypi": "+cgr.", "npm": "+custom.", "golang": "-cgr."}
+
+
+def test_chainguard_libraries_empty_version_marker_rejected(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: ''\n      pypi: ''\n")
+
+    with pytest.raises(ValueError, match=r"empty version marker for \['npm', 'pypi'\]"):
+        config.load(str(path))
+
+
+@pytest.mark.parametrize("source", ["yaml", "env"])
+def test_chainguard_libraries_non_map_version_markers_rejected(tmp_path, monkeypatch, source):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers: invalid\n" if source == "yaml" else "{}\n")
+    if source == "env":
+        monkeypatch.setenv("VUNNEL_PROVIDERS_CHAINGUARD_LIBRARIES_VERSION_MARKERS", "invalid")
+
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(str(path))
+
+
+def test_chainguard_libraries_version_markers_in_cli_config_output(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("{}\n")
+
+    result = CliRunner().invoke(cli, ["--config", str(path), "config"])
+
+    assert result.exit_code == 0
+    assert yaml.safe_load(result.output.split("\n", 1)[1])["providers"]["chainguard_libraries"]["version_markers"] == {
+        "pypi": "+cgr.", "maven": ".cgr.", "npm": "-cgr.", "golang": "-cgr."
+    }
 
 
