 from __future__ import annotations
 
 from dataclasses import dataclass, field
+from re import escape
 from typing import Optional
 
 import pytest
@@ -8,6 +9,33 @@ from vunnel import provider, providers, result
 from vunnel.cli import config
 
 
+def test_chainguard_libraries_version_markers_merge(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: -custom.\n      maven: null\n")
+    markers = config.load(str(path)).providers.chainguard_libraries.version_markers
+    assert markers == {"pypi": "+cgr.", "npm": "-custom.", "golang": "-cgr."}
+
+
+@pytest.mark.parametrize("value,message", [
+    ("      npm: ''\n      pypi: ''\n", "empty version marker for ['npm', 'pypi']"),
+    ("    version_markers: invalid\n", "version_markers must be a map"),
+])
+def test_chainguard_libraries_invalid_version_markers(tmp_path, value, message):
+    path = tmp_path / "config.yaml"
+    if "version_markers:" in value:
+        path.write_text("providers:\n  chainguard_libraries:\n" + value)
+    else:
+        path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n" + value)
+    with pytest.raises(ValueError, match=escape(message)):
+        config.load(str(path))
+
+
+def test_chainguard_libraries_env_version_markers_is_rejected(tmp_path, monkeypatch):
+    monkeypatch.setenv("VUNNEL_PROVIDERS_CHAINGUARD_LIBRARIES_VERSION_MARKERS", "invalid")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(str(tmp_path / "missing.yaml"))
+
+
 def test_minimal_config(helpers):
     cfg_path = helpers.local_dir("test-fixtures/minimal.yaml")
     cfg = config.load(path=cfg_path)
