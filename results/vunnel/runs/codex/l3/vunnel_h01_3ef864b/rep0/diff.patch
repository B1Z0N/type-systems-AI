+    def test_filter_statements_uses_configured_markers(self, openvex_parser):
+        products = [
+            {"identifiers": {"purl": f"pkg:{kind}/example@1.0{suffix}"}}
+            for kind, suffix in [
+                ("pypi", "+cgr.1"), ("maven", ".cgr.1"),
+                ("npm", "-cgr.1"), ("golang", "-cgr.1"),
+                ("npm", "-other.1"), ("cargo", "-cgr.1"),
+            ]
+        ]
+        assert openvex_parser.version_markers == {
+            "pypi": "+cgr.", "maven": ".cgr.", "npm": "-cgr.", "golang": "-cgr."
+        }
+        assert openvex_parser._filter_statements({"products": products})["products"] == products[:4]
+
+        openvex_parser.version_markers = {"npm": "-custom."}
+        assert openvex_parser._filter_statements({"products": products})["products"] == []
+        custom_product = {"identifiers": {"purl": "pkg:npm/example@1.0-custom.2"}}
+        assert openvex_parser._filter_statements({"products": [custom_product]})["products"] == [custom_product]
+
