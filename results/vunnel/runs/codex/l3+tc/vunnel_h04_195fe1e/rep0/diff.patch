+def test_advisory_fix_dates_include_library_clone_and_use_utc_date(helpers, auto_fake_fixdate_finder):
+    workspace = helpers.provider_workspace_helper(name=Provider.name())
+    parser = Parser(ws=workspace, fixdater=auto_fake_fixdate_finder)
+    advisory = {
+        "id": "ALSA-2019:3706",
+        "published": "2019-11-06T23:30:00-02:00",
+        "affected": [{
+            "package": {"name": "lua", "ecosystem": "AlmaLinux:8"},
+            "ranges": [
+                {"type": "ECOSYSTEM", "events": [{"introduced": "0"}, {"fixed": "5.3.4-12.el8"}, {"fixed": "5.3.4-13.el8"}]},
+                {"type": "ECOSYSTEM", "events": [{"introduced": "0"}]},
+            ],
+        }],
+    }
+
+    record = parser._normalize(advisory, "8")[2]
+
+    assert record["database_specific"]["anchore"] == {"record_type": "advisory"}
+    assert {pkg["package"]["name"] for pkg in record["affected"]} == {"lua", "lua-libs"}
+    for pkg in record["affected"]:
+        assert pkg["ranges"][0]["database_specific"]["anchore"]["fixes"] == [
+            {"version": "5.3.4-12.el8", "date": "2019-11-07", "kind": "advisory"},
+            {"version": "5.3.4-13.el8", "date": "2019-11-07", "kind": "advisory"},
+        ]
+        assert "database_specific" not in pkg["ranges"][1]
+
+
+def test_parser_downloads_fix_dates_once_per_get(helpers, auto_fake_fixdate_finder, monkeypatch):
+    workspace = helpers.provider_workspace_helper(name=Provider.name())
+    parser = Parser(ws=workspace, fixdater=auto_fake_fixdate_finder, alma_linux_versions=["8", "9"])
+    monkeypatch.setattr(parser.git_wrapper, "delete_repo", lambda: None)
+    monkeypatch.setattr(parser.git_wrapper, "clone_repo", lambda: None)
+    monkeypatch.setattr(parser, "_load", lambda version: iter([{"id": f"ALSA-{version}", "affected": []}]))
+    downloads = []
+    monkeypatch.setattr(auto_fake_fixdate_finder, "download", lambda: downloads.append(True))
+
+    with parser:
+        assert len(list(parser.get())) == 2
+
+    assert downloads == [True]
