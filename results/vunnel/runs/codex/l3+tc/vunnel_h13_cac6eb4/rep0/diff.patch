index 0000000..3976c94
--- /dev/null
+++ b/tests/unit/test_provider_registry.py
@@ -0,0 +1,82 @@
+import pytest
+
+from vunnel import providers
+
+
+@pytest.fixture
+def registry(monkeypatch):
+    original = providers.alpine.Provider
+    replacement = providers.ubuntu.Provider
+    monkeypatch.setattr(providers, "_providers", {"alpine": original})
+    return original, replacement
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (None, providers.PluginOverrideMode.FAIL),
+        ("", providers.PluginOverrideMode.FAIL),
+        ("unknown", providers.PluginOverrideMode.FAIL),
+        ("FaIl", providers.PluginOverrideMode.FAIL),
+        ("RePlAcE", providers.PluginOverrideMode.REPLACE),
+        ("IGNORE", providers.PluginOverrideMode.IGNORE),
+    ],
+)
+def test_plugin_override_mode_from_env(monkeypatch, value, expected):
+    if value is None:
+        monkeypatch.delenv("VUNNEL_PLUGIN_OVERRIDE_MODE", raising=False)
+    else:
+        monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", value)
+    assert providers.PluginOverrideMode.from_env() is expected
+
+
+@pytest.mark.parametrize("mode", list(providers.PluginOverrideMode))
+def test_register_new_name_in_every_mode(registry, mode):
+    _, replacement = registry
+    providers.register("new", replacement, mode=mode)
+    assert providers.provider_class("new") is replacement
+
+
+def test_register_collision_fails_by_default(registry, monkeypatch):
+    original, replacement = registry
+    monkeypatch.delenv("VUNNEL_PLUGIN_OVERRIDE_MODE", raising=False)
+    with pytest.raises(KeyError, match="already registered"):
+        providers.register("alpine", replacement)
+    assert providers.provider_class("alpine") is original
+
+
+@pytest.mark.parametrize(
+    ("mode", "expected_replacement"),
+    [
+        (providers.PluginOverrideMode.REPLACE, True),
+        (providers.PluginOverrideMode.IGNORE, False),
+    ],
+)
+def test_register_collision_modes(registry, mode, expected_replacement):
+    original, replacement = registry
+    providers.register("alpine", replacement, mode=mode)
+    assert providers.provider_class("alpine") is (replacement if expected_replacement else original)
+
+
+def test_register_reads_environment_for_each_call(registry, monkeypatch):
+    original, replacement = registry
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "ignore")
+    providers.register("alpine", replacement)
+    assert providers.provider_class("alpine") is original
+
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "replace")
+    providers.register("alpine", replacement)
+    assert providers.provider_class("alpine") is replacement
+
+
+def test_explicit_mode_takes_precedence_over_environment(registry, monkeypatch):
+    original, replacement = registry
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "replace")
+    providers.register("alpine", replacement, mode=providers.PluginOverrideMode.IGNORE)
+    assert providers.provider_class("alpine") is original
+
+
+def test_registering_same_class_is_allowed_in_fail_mode(registry):
+    original, _ = registry
+    providers.register("alpine", original, mode=providers.PluginOverrideMode.FAIL)
+    assert providers.provider_class("alpine") is original
