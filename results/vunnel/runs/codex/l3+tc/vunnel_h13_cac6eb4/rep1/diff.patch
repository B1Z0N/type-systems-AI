+def register(name: str, cls: type[provider.Provider], mode: PluginOverrideMode | None = None) -> None:
+    if mode is None:
+        mode = PluginOverrideMode.from_env()
+
+    if name in _providers and _providers[name] is not cls:
+        if mode is PluginOverrideMode.FAIL:
+            raise KeyError(f"provider {name!r} is already registered to another provider class: {_providers[name]!r}")
+        if mode is PluginOverrideMode.IGNORE:
+            return
     _providers[name] = cls
 
 
diff --git a/tests/unit/test_providers_registry.py b/tests/unit/test_providers_registry.py
