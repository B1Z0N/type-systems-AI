@@ -70,6 +70,27 @@ class TestOpenVEXParser:
         assert OpenVEXParser._extract_filename_from_url("https://example.com/file.json") == "file.json"
         assert OpenVEXParser._extract_filename_from_url("/local/path/file.json") == "file.json"
 
+    def test_filter_statements_uses_configured_markers(self, openvex_parser):
+        products = [
+            {"identifiers": {"purl": purl}}
+            for purl in (
+                "pkg:pypi/example@1.0+cgr.1",
+                "pkg:maven/example/name@1.0.cgr.1",
+                "pkg:npm/example@1.0-cgr.1",
+                "pkg:golang/example.com/name@1.0-cgr.1",
+                "pkg:npm/example@1.0",
+                "pkg:gem/example@1.0-cgr.1",
+            )
+        ]
+        assert openvex_parser.version_markers == {
+            "pypi": "+cgr.", "maven": ".cgr.", "npm": "-cgr.", "golang": "-cgr."
+        }
+        assert openvex_parser._filter_statements({"products": products})["products"] == products[:4]
+
+        openvex_parser.version_markers = {"npm": "+custom."}
+        custom = {"identifiers": {"purl": "pkg:npm/example@1.0+custom.1"}}
+        assert openvex_parser._filter_statements({"products": products + [custom]})["products"] == [custom]
+
     def test_build_reference_links(self, openvex_parser):
