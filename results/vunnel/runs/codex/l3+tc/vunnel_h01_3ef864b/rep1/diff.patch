diff --git a/tests/unit/cli/test_config.py b/tests/unit/cli/test_config.py
index 0320c8a..c12fea6 100644
--- a/tests/unit/cli/test_config.py
+++ b/tests/unit/cli/test_config.py
@@ -8,6 +8,26 @@ from vunnel import provider, providers, result
 from vunnel.cli import config
 
 
+def test_chainguard_libraries_version_markers_merge_and_disable(tmp_path):
+    path = tmp_path / "vunnel.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: '+custom.'\n      maven: null\n")
+    markers = config.load(str(path)).providers.chainguard_libraries.version_markers
+    assert markers == {"pypi": "+cgr.", "npm": "+custom.", "golang": "-cgr."}
+
+
+def test_chainguard_libraries_version_markers_reject_empty(tmp_path):
+    path = tmp_path / "vunnel.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: ''\n")
+    with pytest.raises(ValueError, match=r"empty version marker for \['npm'\]"):
+        config.load(str(path))
+
+
+def test_chainguard_libraries_version_markers_reject_non_map_env(tmp_path, monkeypatch):
+    monkeypatch.setenv("VUNNEL_PROVIDERS_CHAINGUARD_LIBRARIES_VERSION_MARKERS", "npm:-cgr.")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(str(tmp_path / "missing.yaml"))
+
+
