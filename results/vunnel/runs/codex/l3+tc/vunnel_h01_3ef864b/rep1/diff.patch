+++ b/src/vunnel/providers/chainguard_libraries/openvex_parser.py
@@ -19,6 +19,20 @@ if TYPE_CHECKING:
     from vunnel import workspace
 
 
+DEFAULT_VERSION_MARKERS = {"pypi": "+cgr.", "maven": ".cgr.", "npm": "-cgr.", "golang": "-cgr."}
+
+
+def normalize_version_markers(markers: object) -> dict[str, str]:
+    if not isinstance(markers, dict):
+        raise ValueError("version_markers must be a map")
+    if any(not isinstance(key, str) or (value is not None and not isinstance(value, str)) for key, value in markers.items()):
+        raise ValueError("version_markers must map purl types to strings or null")
+    empty = sorted(key for key, value in markers.items() if value == "")
+    if empty:
+        raise ValueError(f"empty version marker for {empty}")
+    return {key: value for key, value in markers.items() if value is not None}
+
+
