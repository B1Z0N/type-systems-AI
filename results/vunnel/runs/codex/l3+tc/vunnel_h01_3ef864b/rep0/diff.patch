index 0320c8a..c7343f9 100644
--- a/tests/unit/cli/test_config.py
+++ b/tests/unit/cli/test_config.py
@@ -8,6 +8,36 @@ from vunnel import provider, providers, result
 from vunnel.cli import config
 
 
+def test_chainguard_libraries_version_markers_merge_and_disable(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: '-custom.'\n      maven: null\n")
+
+    markers = config.load(path=str(path)).providers.chainguard_libraries.version_markers
+    assert markers == {"pypi": "+cgr.", "npm": "-custom.", "golang": "-cgr."}
+
+
+@pytest.mark.parametrize(
+    "value, message",
+    [
+        ("'bad'", "version_markers must be a map"),
+        ("{pypi: '', npm: ''}", r"empty version marker for \['npm', 'pypi'\]"),
+    ],
+)
+def test_chainguard_libraries_rejects_invalid_version_markers(tmp_path, value, message):
+    path = tmp_path / "config.yaml"
+    path.write_text(f"providers:\n  chainguard_libraries:\n    version_markers: {value}\n")
+    with pytest.raises(ValueError, match=message):
+        config.load(path=str(path))
+
+
+def test_chainguard_libraries_rejects_environment_string_marker_map(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("{}")
+    monkeypatch.setenv("VUNNEL_PROVIDERS_CHAINGUARD_LIBRARIES_VERSION_MARKERS", "npm=-cgr.")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(path=str(path))
+
+
