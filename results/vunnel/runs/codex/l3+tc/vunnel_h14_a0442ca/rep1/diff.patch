+def _collect_packages(criteria, oval_ns, config: Config, arch=None):
+    # Architecture applies to sibling package checks and their descendants.
+    packages = []
+    for criterion in criteria.findall(f"{oval_ns}criterion"):
+        match = re.search(config.arch_pattern, criterion.attrib["comment"])
+        if match:
+            arch = match.group(1)
+    for criterion in criteria.findall(f"{oval_ns}criterion"):
+        match = re.search(config.pkg_version_pattern, criterion.attrib["comment"])
+        if match:
+            packages.append((*match.groups(), arch))
+    for child in criteria.findall(f"{oval_ns}criteria"):
+        packages.extend(_collect_packages(child, oval_ns, config, arch))
+    return packages
