@@ -8,6 +8,33 @@ from vunnel import provider, providers, result
 from vunnel.cli import config
 
 
+def test_chainguard_libraries_version_markers_merge(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: '+custom.'\n      golang: null\n")
+    markers = config.load(str(path)).providers.chainguard_libraries.version_markers
+    assert markers == {"pypi": "+cgr.", "maven": ".cgr.", "npm": "+custom."}
+
+
+def test_chainguard_libraries_version_markers_empty(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: ''\n")
+    with pytest.raises(ValueError, match=r"empty version marker for \['npm'\]"):
+        config.load(str(path))
+
+
+def test_chainguard_libraries_version_markers_env_must_be_map(tmp_path, monkeypatch):
+    monkeypatch.setenv("VUNNEL_PROVIDERS_CHAINGUARD_LIBRARIES_VERSION_MARKERS", "invalid")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(str(tmp_path / "missing.yaml"))
+
+
+def test_chainguard_libraries_version_markers_yaml_must_be_map(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers: invalid\n")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(str(path))
+
+
