@@ -8,6 +8,35 @@ from vunnel import provider, providers, result
 from vunnel.cli import config
 
 
+def test_chainguard_library_version_markers_merge_and_disable(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: '+custom.'\n      maven: null\n")
+    markers = config.load(path=str(path)).providers.chainguard_libraries.version_markers
+    assert markers == {"pypi": "+cgr.", "npm": "+custom.", "golang": "-cgr."}
+
+
+def test_chainguard_library_empty_marker_is_rejected(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: ''\n")
+    with pytest.raises(ValueError, match=r"empty version marker for \['npm'\]"):
+        config.load(path=str(path))
+
+
+def test_chainguard_library_non_map_marker_is_rejected(tmp_path, monkeypatch):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers: {}\n")
+    monkeypatch.setenv("VUNNEL_PROVIDERS_CHAINGUARD_LIBRARIES_VERSION_MARKERS", "npm=-cgr.")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(path=str(path))
+
+
+def test_chainguard_library_non_map_yaml_is_rejected(tmp_path):
+    path = tmp_path / "config.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers: invalid\n")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(path=str(path))
+
+
