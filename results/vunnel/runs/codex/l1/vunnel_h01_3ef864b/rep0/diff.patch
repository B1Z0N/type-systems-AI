+DEFAULT_VERSION_MARKERS = {"pypi": "+cgr.", "maven": ".cgr.", "npm": "-cgr.", "golang": "-cgr."}
+
+
+def normalize_version_markers(markers: dict[str, str | None]) -> dict[str, str]:
+    if not isinstance(markers, dict):
+        raise ValueError("version_markers must be a map")
+    empty = sorted(key for key, value in markers.items() if value == "")
+    if empty:
+        raise ValueError(f"empty version marker for {empty}")
+    return {key: value for key, value in markers.items() if value is not None}
+
