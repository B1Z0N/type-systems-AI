diff --git a/tests/unit/test_provider_registration.py b/tests/unit/test_provider_registration.py
new file mode 100644
index 0000000..3434130
--- /dev/null
+++ b/tests/unit/test_provider_registration.py
@@ -0,0 +1,64 @@
+import pytest
+
+from vunnel import providers
+
+
+class PluginProvider:
+    pass
+
+
+@pytest.mark.parametrize(
+    ("value", "expected"),
+    [
+        (None, "FAIL"),
+        ("", "FAIL"),
+        ("unknown", "FAIL"),
+        ("fail", "FAIL"),
+        ("RePlAcE", "REPLACE"),
+        ("IGNORE", "IGNORE"),
+    ],
+)
+def test_plugin_override_mode_from_env(monkeypatch, value, expected):
+    if value is None:
+        monkeypatch.delenv("VUNNEL_PLUGIN_OVERRIDE_MODE", raising=False)
+    else:
+        monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", value)
+
+    assert providers.PluginOverrideMode.from_env() is getattr(providers.PluginOverrideMode, expected)
+
+
+@pytest.mark.parametrize(
+    ("mode", "expected"),
+    [("FAIL", "error"), ("REPLACE", PluginProvider), ("IGNORE", "original")],
+)
+def test_register_collision_with_explicit_mode(monkeypatch, mode, expected):
+    original = providers.provider_class("alpine")
+    monkeypatch.setitem(providers._providers, "alpine", original)
+
+    if expected == "error":
+        with pytest.raises(KeyError):
+            providers.register("alpine", PluginProvider, getattr(providers.PluginOverrideMode, mode))
+        assert providers.provider_class("alpine") is original
+    else:
+        providers.register("alpine", PluginProvider, getattr(providers.PluginOverrideMode, mode))
+        assert providers.provider_class("alpine") is (original if expected == "original" else expected)
+
+
+def test_register_uses_environment_at_call_time(monkeypatch):
+    original = providers.provider_class("alpine")
+    monkeypatch.setitem(providers._providers, "alpine", original)
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "ignore")
+    providers.register("alpine", PluginProvider)
+    assert providers.provider_class("alpine") is original
+
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "replace")
+    providers.register("alpine", PluginProvider)
+    assert providers.provider_class("alpine") is PluginProvider
+
+
+@pytest.mark.parametrize("mode", ["FAIL", "REPLACE", "IGNORE"])
+def test_register_new_name_in_every_mode(monkeypatch, mode):
+    monkeypatch.delitem(providers._providers, "test-plugin", raising=False)
+    providers.register("test-plugin", PluginProvider, getattr(providers.PluginOverrideMode, mode))
+    assert providers.provider_class("test-plugin") is PluginProvider
+    monkeypatch.delitem(providers._providers, "test-plugin")
