diff --git a/tests/unit/test_provider_registration.py b/tests/unit/test_provider_registration.py
new file mode 100644
index 0000000..3c3a552
--- /dev/null
+++ b/tests/unit/test_provider_registration.py
@@ -0,0 +1,92 @@
+import pytest
+
+from vunnel import providers
+
+
+class BuiltinProvider:
+    pass
+
+
+class PluginProvider:
+    pass
+
+
+@pytest.fixture
+def registry(monkeypatch):
+    registered = {"builtin": BuiltinProvider}
+    monkeypatch.setattr(providers, "_providers", registered)
+    return registered
+
+
+@pytest.mark.parametrize(
+    "value,expected",
+    [
+        (None, "FAIL"),
+        ("", "FAIL"),
+        ("unknown", "FAIL"),
+        ("fail", "FAIL"),
+        ("FaIl", "FAIL"),
+        ("replace", "REPLACE"),
+        ("RePlAcE", "REPLACE"),
+        ("ignore", "IGNORE"),
+        ("IgNoRe", "IGNORE"),
+    ],
+)
+def test_override_mode_from_env(monkeypatch, value, expected):
+    if value is None:
+        monkeypatch.delenv("VUNNEL_PLUGIN_OVERRIDE_MODE", raising=False)
+    else:
+        monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", value)
+
+    assert providers.PluginOverrideMode.from_env() is getattr(providers.PluginOverrideMode, expected)
+
+
+@pytest.mark.parametrize("mode", ["FAIL", "REPLACE", "IGNORE"])
+def test_register_new_name_in_every_mode(registry, mode):
+    providers.register("plugin", PluginProvider, mode=getattr(providers.PluginOverrideMode, mode))
+
+    assert providers.provider_class("plugin") is PluginProvider
+
+
+@pytest.mark.parametrize("mode", ["FAIL", "REPLACE", "IGNORE"])
+def test_register_same_class_in_every_mode(registry, mode):
+    providers.register("builtin", BuiltinProvider, mode=getattr(providers.PluginOverrideMode, mode))
+
+    assert providers.provider_class("builtin") is BuiltinProvider
+
+
+def test_register_collision_fails(registry):
+    with pytest.raises(KeyError, match="already registered"):
+        providers.register("builtin", PluginProvider, mode=providers.PluginOverrideMode.FAIL)
+
+    assert providers.provider_class("builtin") is BuiltinProvider
+
+
+def test_register_collision_replaces(registry):
+    providers.register("builtin", PluginProvider, mode=providers.PluginOverrideMode.REPLACE)
+
+    assert providers.provider_class("builtin") is PluginProvider
+
+
+def test_register_collision_ignores(registry):
+    providers.register("builtin", PluginProvider, mode=providers.PluginOverrideMode.IGNORE)
+
+    assert providers.provider_class("builtin") is BuiltinProvider
+
+
+def test_register_reads_environment_at_each_call(monkeypatch, registry):
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "ignore")
+    providers.register("builtin", PluginProvider)
+    assert providers.provider_class("builtin") is BuiltinProvider
+
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "replace")
+    providers.register("builtin", PluginProvider)
+    assert providers.provider_class("builtin") is PluginProvider
+
+
+def test_explicit_mode_takes_precedence_over_environment(monkeypatch, registry):
+    monkeypatch.setenv("VUNNEL_PLUGIN_OVERRIDE_MODE", "ignore")
+
+    providers.register("builtin", PluginProvider, mode=providers.PluginOverrideMode.REPLACE)
+
+    assert providers.provider_class("builtin") is PluginProvider
