+def test_fix_dates_cover_library_clones_and_use_utc_published_date(helpers):
+    workspace = helpers.provider_workspace_helper(name=Provider.name())
+    parser = Parser(ws=workspace, fixdater=MagicMock())
+    record = {
+        "id": "ALSA-2019:3706",
+        "published": "2019-11-13T23:30:00-02:00",
+        "database_specific": {"source": "upstream", "anchore": {"other": "keep"}},
+        "affected": [
+            {
+                "package": {"ecosystem": "AlmaLinux:8", "name": "lua"},
+                "ranges": [
+                    {
+                        "type": "ECOSYSTEM",
+                        "events": [{"introduced": "0"}, {"fixed": "5.3.4-11.el8"}, {"fixed": "5.3.4-12.el8"}],
+                        "database_specific": {"source": "range"},
+                    },
+                    {"type": "ECOSYSTEM", "events": [{"introduced": "5.3.4-12.el8"}, {"fixed": "5.3.4-13.el8"}]},
+                ],
+            }
+        ],
+    }
+
+    _, _, normalized = parser._normalize(record, "8")
+
+    assert normalized["database_specific"] == {"source": "upstream", "anchore": {"other": "keep", "record_type": "advisory"}}
+    assert [affected["package"]["name"] for affected in normalized["affected"]] == ["lua", "lua-libs"]
+    for affected in normalized["affected"]:
+        first, second = affected["ranges"]
+        assert first["database_specific"] == {
+            "source": "range",
+            "anchore": {
+                "fixes": [
+                    {"version": "5.3.4-11.el8", "date": "2019-11-14", "kind": "advisory"},
+                    {"version": "5.3.4-12.el8", "date": "2019-11-14", "kind": "advisory"},
+                ]
+            },
+        }
+        assert second["database_specific"]["anchore"]["fixes"] == [
+            {"version": "5.3.4-13.el8", "date": "2019-11-14", "kind": "advisory"},
+        ]
 
