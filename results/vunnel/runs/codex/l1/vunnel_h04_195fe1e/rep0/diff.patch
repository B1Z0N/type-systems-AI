+    def _add_fix_dates(self, vuln_entry: dict) -> None:
+        """Use the upstream advisory publication date for every fixed version."""
+        published = vuln_entry.get("published")
+        if published:
+            published_date = datetime.fromisoformat(published.replace("Z", "+00:00")).astimezone(UTC).date().isoformat()
+            for affected_pkg in vuln_entry.get("affected", []):
+                for range_data in affected_pkg.get("ranges", []):
