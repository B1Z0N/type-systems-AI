@@ -1,11 +1,71 @@
 from __future__ import annotations
 
 import shutil
+import json
+from pathlib import Path
 
+import jsonschema
 import pytest
 from pytest_unordered import unordered
 from vunnel import result, workspace
 from vunnel.providers.oracle import Config, Provider, parser
+from vunnel import schema
+
+
+def test_architecture_specific_and_shared_fixes(tmp_path):
+    oval = """<oval_definitions xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5">
+    <definitions><definition version="1"><metadata>
+      <title>ELSA-2022-4803: rsyslog security update</title>
+      <affected><platform>Oracle Linux 7</platform></affected>
+      <reference source="elsa" ref_id="ELSA-2022-4803" ref_url="https://linux.oracle.com/errata/ELSA-2022-4803.html"/>
+      <description>Test advisory</description><advisory><severity>IMPORTANT</severity><issued date="2022-05-31"/></advisory>
+    </metadata><criteria operator="AND">
+      <criterion comment="Oracle Linux 7 is installed"/>
+      <criterion comment="shared is earlier than 1-0"/>
+      <criteria operator="OR">
+        <criteria operator="AND"><criterion comment="Oracle Linux arch is aarch64"/>
+          <criteria operator="OR">
+            <criterion comment="rsyslog is earlier than 8.24.0-57.0.4.el7_9.3"/>
+            <criterion comment="shared is earlier than 1-1"/>
+            <criterion comment="shared is earlier than 1-2"/>
+          </criteria>
+        </criteria>
+        <criteria operator="AND"><criterion comment="Oracle Linux arch is x86_64"/>
+          <criteria operator="OR">
+            <criterion comment="rsyslog is earlier than 8.24.0-57.0.1.el7_9.3"/>
+            <criterion comment="shared is earlier than 1-1"/>
+            <criterion comment="shared is earlier than 1-2"/>
+          </criteria>
+        </criteria>
+      </criteria>
+    </criteria></definition></definitions></oval_definitions>"""
+    path = tmp_path / "oracle.xml"
+    path.write_text(oval)
+
+    records = parser.Parser(workspace=workspace.Workspace(tmp_path, "test", create=True))._parse_oval_data(
+        str(path), parser.ol_config
+    )
+    fixes = records[("ELSA-2022-4803", "ol:7")][1]["Vulnerability"]["FixedIn"]
+    assert {(fix["Name"], fix["Version"], fix.get("Arch")) for fix in fixes} == {
+        ("rsyslog", "8.24.0-57.0.4.el7_9.3", "aarch64"),
+        ("rsyslog", "8.24.0-57.0.1.el7_9.3", "x86_64"),
+        ("shared", "1-1", None),
+        ("shared", "1-2", None),
+        ("shared", "1-0", None),
+    }
+    assert len(fixes) == 5
+    schema_path = Path(__file__).parents[4] / "schema/vulnerability/os/schema-1.1.1.json"
+    jsonschema.validate(records[("ELSA-2022-4803", "ol:7")][1], json.loads(schema_path.read_text()))
+
+
+def test_oracle_advertises_arch_schema_only():
+    assert Provider.__schema__ == schema.OSSchema("1.1.1")
+    assert schema.OSSchema().version == "1.1.0"
+    schema_path = Path(__file__).parents[4] / "schema/vulnerability/os/schema-1.1.1.json"
+    os_schema = json.loads(schema_path.read_text())
+    fixed_in_properties = os_schema["properties"]["Vulnerability"]["properties"]["FixedIn"]["items"][0]
+    assert fixed_in_properties["properties"]["Arch"] == {"type": "string"}
+    assert "Arch" not in fixed_in_properties["required"]
 
 
