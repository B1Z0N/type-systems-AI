@@ -1,11 +1,78 @@
 from __future__ import annotations
 
 import shutil
+import xml.etree.ElementTree as ET
 
 import pytest
 from pytest_unordered import unordered
 from vunnel import result, workspace
 from vunnel.providers.oracle import Config, Provider, parser
+from vunnel.providers.oracle.oval_parser import _process_criteria, _process_definition
+
+
+def test_architecture_specific_fixes():
+    def definition(branches):
+        return ET.fromstring(
+            '<definition xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5">'
+            '<criteria operator="AND">'
+            '<criterion comment="Oracle Linux 7 is installed"/>'
+            f'{branches}'
+            '</criteria></definition>'
+        )
+
+    def branch(arch, fixes):
+        criteria = ''.join(f'<criterion comment="{name} is earlier than {version}"/>' for name, version in fixes)
+        return f'<criteria operator="AND"><criterion comment="Oracle Linux arch is {arch}"/>{criteria}</criteria>'
+
+    aarch64 = [("rsyslog", "8.24.0-57.0.4.el7_9.3"), ("shared", "1"), ("rebuilt", "1"), ("rebuilt", "2")]
+    x86_64 = [("rsyslog", "8.24.0-57.0.1.el7_9.3"), ("shared", "1"), ("rebuilt", "1"), ("rebuilt", "2")]
+    criteria = _process_criteria(
+        definition(branch("aarch64", aarch64) + branch("x86_64", x86_64)),
+        "{http://oval.mitre.org/XMLSchema/oval-definitions-5}",
+        parser.ol_config,
+    )
+
+    assert criteria == {"ol:7": {
+        ("rsyslog", "8.24.0-57.0.4.el7_9.3", None, "aarch64"),
+        ("rsyslog", "8.24.0-57.0.1.el7_9.3", None, "x86_64"),
+        ("shared", "1", None, None),
+        ("rebuilt", "1", None, None),
+        ("rebuilt", "2", None, None),
+    }}
+
+
+def test_architecture_specific_fixed_in_records():
+    definition = ET.fromstring('''
+        <definition xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5" version="1">
+          <metadata>
+            <title>ELSA-2022-4803: rsyslog update</title>
+            <affected><platform>Oracle Linux 7</platform></affected>
+            <reference source="elsa" ref_id="ELSA-2022-4803" ref_url="https://linux.oracle.com/errata/ELSA-2022-4803.html"/>
+            <advisory><severity>IMPORTANT</severity><issued date="2022-01-01"/></advisory>
+          </metadata>
+          <criteria operator="AND">
+            <criterion comment="Oracle Linux 7 is installed"/>
+            <criteria operator="OR">
+              <criteria operator="AND">
+                <criterion comment="Oracle Linux arch is aarch64"/>
+                <criterion comment="rsyslog is earlier than 8.24.0-57.0.4.el7_9.3"/>
+              </criteria>
+              <criteria operator="AND">
+                <criterion comment="Oracle Linux arch is x86_64"/>
+                <criterion comment="rsyslog is earlier than 8.24.0-57.0.1.el7_9.3"/>
+              </criteria>
+            </criteria>
+          </criteria>
+        </definition>
+    ''')
+    records = {}
+    _process_definition(definition, records, parser.ol_config)
+    fixes = records[("ELSA-2022-4803", "ol:7")][1]["Vulnerability"]["FixedIn"]
+    assert {(fix["Version"], fix["Arch"]) for fix in fixes} == {
+        ("8.24.0-57.0.4.el7_9.3", "aarch64"),
+        ("8.24.0-57.0.1.el7_9.3", "x86_64"),
+    }
+    assert Provider.__schema__.version == "1.1.1"
 
 
