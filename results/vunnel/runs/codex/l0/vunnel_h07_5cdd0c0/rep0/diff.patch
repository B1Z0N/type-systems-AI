+    p = SecDBParser(
+        workspace=workspace.Workspace(tmpdir, "test", create=True),
+        url="https://example.com/security.json",
+        namespace=namespace,
+    )
+    go_id = "GO-2026-5932"
+    cve_id = "CVE-2023-1234"
+    security_url = p.security_reference_url
+
+    assert p.build_reference_links(go_id) == [f"{security_url}/{go_id}"]
+    assert p.build_reference_links(cve_id) == [
+        f"{security_url}/{cve_id}",
+        f"https://www.cve.org/CVERecord?id={cve_id}",
+        f"https://nvd.nist.gov/vuln/detail/{cve_id}",
+    ]
+
+    data = {"packages": [{"pkg": {"name": "go", "secfixes": {"1.0-r0": [go_id]}}}]}
+    records = p._normalize("rolling", data)
+    assert records[go_id]["Vulnerability"]["Link"] == f"{security_url}/{go_id}"
