+
+def _walk_arch_criteria(node, config, packages, arches, arch=None):
+    # A branch's architecture criterion applies to all its sibling package checks.
+    for child in node:
+        if child.tag.endswith("}criterion"):
+            match = re.search(config.arch_pattern, child.attrib.get("comment", ""))
+            if match:
+                arch = match.group(1)
