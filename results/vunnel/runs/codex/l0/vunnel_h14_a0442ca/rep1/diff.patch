+            {("1.0-1", None), ("1.0-2", None)},
+        ),
+    ],
+)
+def test_architecture_specific_fixes(tmp_path, arch_versions, expected):
+    branches = "".join(
+        f'<criteria operator="AND"><criterion comment="Oracle Linux arch is {arch}"/>'
+        + "".join(f'<criterion comment="rsyslog is earlier than {version}"/>' for version in versions)
+        + "</criteria>"
+        for arch, versions in arch_versions.items()
+    )
+    xml = f"""<oval_definitions xmlns="http://oval.mitre.org/XMLSchema/oval-definitions-5">
+      <definitions><definition version="1"><metadata>
+        <title>ELSA-2022-4803: rsyslog security update</title>
+        <affected><platform>Oracle Linux 7</platform></affected>
+        <reference source="elsa" ref_id="ELSA-2022-4803" ref_url="https://example.com/advisory"/>
+        <advisory><severity>IMPORTANT</severity><issued date="2022-10-01"/></advisory>
+      </metadata><criteria operator="AND">
+        <criterion comment="Oracle Linux 7 is installed"/>
+        <criteria operator="OR">{branches}</criteria>
+      </criteria></definition></definitions>
+    </oval_definitions>"""
+    input_file = tmp_path / "oracle.xml"
+    input_file.write_text(xml)
+
+    subject = parser.Parser(workspace=workspace.Workspace(tmp_path, "test", create=True))
+    records = subject._parse_oval_data(str(input_file), subject.config)
+    fixes = records[("ELSA-2022-4803", "ol:7")][1]["Vulnerability"]["FixedIn"]
+
+    assert {(fix["Version"], fix.get("Arch")) for fix in fixes} == expected
+    assert len(fixes) == len(expected)
+    assert all(fix["Name"] == "rsyslog" for fix in fixes)
+
