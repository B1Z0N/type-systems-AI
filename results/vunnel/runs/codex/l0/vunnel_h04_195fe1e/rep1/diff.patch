+def test_library_clone_gets_published_fix_date_and_downloads_once(helpers, mocker):
+    workspace = helpers.provider_workspace_helper(name=Provider.name())
+    fixdater = mocker.MagicMock()
+    fixdater.best.return_value = Result(date="2024-01-01", kind="first-observed")
+    parser = Parser(ws=workspace, fixdater=fixdater)
+    parser.git_wrapper.delete_repo = mocker.Mock()
+    parser.git_wrapper.clone_repo = mocker.Mock()
+    parser._load = lambda version: iter([{
+        "id": "ALSA-2019:3706",
+        "published": "2019-11-06T00:30:00+01:00",
+        "affected": [{
+            "package": {"name": "lua", "ecosystem": "AlmaLinux:8"},
+            "ranges": [{"type": "ECOSYSTEM", "events": [{"introduced": "0"}, {"fixed": "5.3.4-12.el8"}]}],
+        }],
+    }])
+
+    with parser:
+        records = list(parser.get())
+
+    assert len(records) == 3
+    for _, _, record in records:
+        assert {affected["package"]["name"] for affected in record["affected"]} == {"lua", "lua-libs"}
+        for affected in record["affected"]:
+            assert affected["ranges"][0]["database_specific"]["anchore"]["fixes"] == [
+                {"version": "5.3.4-12.el8", "date": "2019-11-05", "kind": "advisory"}
+            ]
+    fixdater.download.assert_called_once_with()
+    fixdater.__enter__.assert_called_once_with()
+    fixdater.__exit__.assert_called_once()
