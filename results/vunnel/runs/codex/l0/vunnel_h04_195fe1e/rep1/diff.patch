+    def _add_fix_dates(self, vuln_entry):
+        osv.patch_fix_date(vuln_entry, self.fixdater)
+        published = vuln_entry.get("published")
+        if not published:
+            return
+
+        published_date = datetime.fromisoformat(published.replace("Z", "+00:00"))
+        if published_date.tzinfo is None:
+            published_date = published_date.replace(tzinfo=UTC)
+        advisory_date = published_date.astimezone(UTC).date().isoformat()
+        for affected_pkg in vuln_entry.get("affected", []):
+            for affected_range in affected_pkg.get("ranges", []):
