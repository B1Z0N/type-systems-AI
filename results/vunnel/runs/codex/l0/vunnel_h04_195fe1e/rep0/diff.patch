+    @staticmethod
+    def _add_fix_dates(vuln_entry):
+        """Use the upstream advisory's publication day for every fixed event."""
+        published = vuln_entry.get("published")
+        if not published:
+            return
+
+        published_at = datetime.fromisoformat(published.replace("Z", "+00:00"))
+        if published_at.tzinfo is None:
+            published_at = published_at.replace(tzinfo=UTC)
+        fix_date = published_at.astimezone(UTC).date().isoformat()
+        for affected_pkg in vuln_entry.get("affected", []):
+            for affected_range in affected_pkg.get("ranges", []):
+                fixes = [
+                    {"version": event["fixed"], "date": fix_date, "kind": "advisory"}
+                    for event in affected_range.get("events", [])
+                    if event.get("fixed")
+                ]
+                if fixes:
+                    affected_range.setdefault("database_specific", {}).setdefault("anchore", {})["fixes"] = fixes
+
