 import pytest
@@ -8,6 +9,30 @@ from vunnel import provider, providers, result
 from vunnel.cli import config
 
 
+def test_chainguard_library_version_markers_merge_and_disable(tmp_path):
+    path = tmp_path / "vunnel.yaml"
+    path.write_text("providers:\n  chainguard_libraries:\n    version_markers:\n      npm: '-custom.'\n      golang: null\n")
+    markers = config.load(path).providers.chainguard_libraries.version_markers
+    assert markers == {"pypi": "+cgr.", "maven": ".cgr.", "npm": "-custom."}
+
+
+@pytest.mark.parametrize("value, message", [
+    ("{npm: ''}", "empty version marker for ['npm']"),
+    ("not-a-map", "version_markers must be a map"),
+])
+def test_chainguard_library_invalid_version_markers(tmp_path, value, message):
+    path = tmp_path / "vunnel.yaml"
+    path.write_text(f"providers:\n  chainguard_libraries:\n    version_markers: {value}\n")
+    with pytest.raises(ValueError, match=re.escape(message)):
+        config.load(path)
+
+
+def test_chainguard_library_env_marker_override_is_rejected(monkeypatch, tmp_path):
+    monkeypatch.setenv("VUNNEL_PROVIDERS_CHAINGUARD_LIBRARIES_VERSION_MARKERS", "npm=-custom.")
+    with pytest.raises(ValueError, match="version_markers must be a map"):
+        config.load(tmp_path / "missing.yaml")
+
