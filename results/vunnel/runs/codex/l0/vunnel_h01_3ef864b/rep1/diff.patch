+def default_version_markers():
+    return {"pypi": "+cgr.", "maven": ".cgr.", "npm": "-cgr.", "golang": "-cgr."}
+
+
+def validate_version_markers(markers):
+    if not isinstance(markers, dict):
+        raise ValueError("version_markers must be a map")
+    empty = sorted(key for key, marker in markers.items() if marker == "")
+    if empty:
+        raise ValueError(f"empty version marker for {empty}")
+    if any(marker is not None and not isinstance(marker, str) for marker in markers.values()):
+        raise ValueError("version_markers values must be strings or null")
+    return {key: marker for key, marker in markers.items() if marker is not None}
+
+
