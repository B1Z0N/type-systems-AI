+def test_extend_trial_delays_billing(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    end = sub["trial_end"]
+    subscriptions.extend_trial(world.engine.ctx, sub["id"], 7)
+    assert sub["trial_end"] == end + 7 * 86400
+    assert sub["current_period_end"] == end + 7 * 86400
+    world.advance_days(14)
+    assert sub["status"] == "trialing"
+    world.advance_days(7)
+    assert sub["status"] == "active"
+    assert len(world.engine.invoices_for(cus["id"])) == 1
+
+
+def test_extend_trial_validation(world):
+    cus = world.customer()
+    trial = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    for bad in (0, -1, True):
+        with pytest.raises(ValidationError):
+            subscriptions.extend_trial(world.engine.ctx, trial["id"], bad)
+    active = world.engine.subscribe(world.customer()["id"], [(world.monthly["id"], 1)])
+    with pytest.raises(InvalidStateError):
+        subscriptions.extend_trial(world.engine.ctx, active["id"], 3)
+
