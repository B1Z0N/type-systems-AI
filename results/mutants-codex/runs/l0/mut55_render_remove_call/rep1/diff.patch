@@ -0,0 +1,26 @@
+from billing import catalog, tax
+from billing.render import render_invoice
+
+
+def test_render_invoice_shows_exclusive_tax(world):
+    tax.set_tax_rate(world.ctx, "US-CA", 825, "CA")
+    cus = world.customer(region="US-CA")
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    text = render_invoice(world.ctx, inv)
+    assert "Invoice INV-00001" in text
+    assert any("Tax (8.25%)" in line and "$0.82" in line for line in text.splitlines())
+    assert "$10.82" in text
+
+
+def test_render_invoice_shows_inclusive_tax(world):
+    price = catalog.create_price(world.ctx, world.plan["id"], "usd", "flat", unit_amount=1200, tax_inclusive=True)
+    tax.set_tax_rate(world.ctx, "DE", 2000, "VAT")
+    cus = world.customer(region="DE")
+    world.engine.subscribe(cus["id"], [(price["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    text = render_invoice(world.ctx, inv)
+    assert any("Tax included (20%)" in line and "$2.00" in line for line in text.splitlines())
+    assert inv["total"] == 1200
