@@ -0,0 +1,26 @@
+from billing import catalog, tax
+from billing.render import render_invoice
+
+
+def test_render_invoice_shows_exclusive_tax(world):
+    tax.set_tax_rate(world.ctx, "US-CA", 825, "CA")
+    customer = world.customer(region="US-CA")
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+
+    text = render_invoice(world.ctx, invoice)
+    assert "Invoice INV-00001" in text
+    assert "Tax (8.25%)" in text
+    assert "$10.82" in text
+
+
+def test_render_invoice_marks_inclusive_tax(world):
+    price = catalog.create_price(world.ctx, world.plan["id"], "usd", "flat", unit_amount=1200, tax_inclusive=True)
+    tax.set_tax_rate(world.ctx, "DE", 2000, "VAT")
+    customer = world.customer(region="DE")
+    world.engine.subscribe(customer["id"], [(price["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+
+    text = render_invoice(world.ctx, invoice)
+    assert "Tax (20%) included" in text
+    assert "$2.00" in text
