diff --git a/tests/test_refunds.py b/tests/test_refunds.py
new file mode 100644
index 0000000..6ce7088
--- /dev/null
+++ b/tests/test_refunds.py
@@ -0,0 +1,120 @@
+import pytest
+
+from billing import ledger
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
+
+
+def _paid_invoice(world, cus=None):
+    cus = cus or world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    return cus, inv
+
+
+def _payments(world, invoice_id):
+    return sorted(world.ctx.store.payments_for_invoice(invoice_id), key=lambda p: (p["created_at"], p["id"]))
+
+
+def test_partial_refund_marks_payment_and_creates_credit_note(world):
+    _, inv = _paid_invoice(world)
+    note = world.engine.refund(inv["id"], amount=300)
+    [payment] = _payments(world, inv["id"])
+    assert payment["refunded_amount"] == 300
+    assert payment["status"] == "partially_refunded"
+    assert note["amount"] == 300
+    assert note["refunded"] is True
+    assert world.gateway.refunds == [(payment["gateway_ref"], 300)]
+
+
+def test_several_partial_refunds_until_exhausted_then_full_refund_fails(world):
+    _, inv = _paid_invoice(world)
+    world.engine.refund(inv["id"], amount=400)
+    world.engine.refund(inv["id"], amount=600)
+    [payment] = _payments(world, inv["id"])
+    assert payment["status"] == "refunded"
+    assert len(world.ctx.store.credit_notes_for(inv["id"])) == 2
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+
+
+def test_partial_refund_spans_payments_oldest_first(world):
+    _, inv = _paid_invoice(world)
+    [first] = _payments(world, inv["id"])
+    # A second successful payment on the same invoice, created after the first one.
+    second = dict(first, id="pay_second", amount=500, refunded_amount=0, gateway_ref="ch_second")
+    world.ctx.store.payments["pay_second"] = second
+    world.gateway._captured["ch_second"] = 500
+    world.engine.refund(inv["id"], amount=1200)
+    assert first["refunded_amount"] == 1000
+    assert first["status"] == "refunded"
+    assert second["refunded_amount"] == 200
+    assert second["status"] == "partially_refunded"
+
+
+@pytest.mark.parametrize("amount", [0, -5, 1001, True, "100"])
+def test_invalid_amount_rejected(world, amount):
+    _, inv = _paid_invoice(world)
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=amount)
+    assert world.gateway.refunds == []
+
+
+def test_full_refund_after_partial_refunds_refunds_only_remainder(world):
+    _, inv = _paid_invoice(world)
+    world.engine.refund(inv["id"], amount=250)
+    note = world.engine.refund(inv["id"])
+    [payment] = _payments(world, inv["id"])
+    assert payment["refunded_amount"] == 1000
+    assert payment["status"] == "refunded"
+    assert note["amount"] == 750
+    assert world.gateway.refunds[-1][1] == 750
+
+
+def test_full_refund_returns_applied_credit_once(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], 300)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    assert inv["credit_applied"] == 300
+    note = world.engine.refund(inv["id"])
+    assert note["amount"] == 700 + 300
+    assert ledger.balance(world.ctx, cus["id"]) == 300
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+    assert ledger.balance(world.ctx, cus["id"]) == 300
+
+
+def test_partial_refund_does_not_return_credit(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], 300)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    world.engine.refund(inv["id"], amount=100)
+    assert ledger.balance(world.ctx, cus["id"]) == 0
+
+
+def test_refund_after_credit_note_still_blocked(world):
+    _, inv = _paid_invoice(world)
+    world.ctx.store.credit_notes["cn_manual"] = {
+        "id": "cn_manual",
+        "invoice_id": inv["id"],
+        "customer_id": inv["customer_id"],
+        "amount": 100,
+        "reason": "goodwill",
+        "refunded": False,
+        "created_at": world.clock.now(),
+    }
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"], amount=100)
+
+
+def test_api_refund_accepts_amount(world):
+    _, inv = _paid_invoice(world)
+    status, body = handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": 200})
+    assert status == 200
+    assert body["amount"] == 200
+    status, body = handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": "200"})
+    assert status == 400
+    status, body = handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": 5000})
+    assert status == 400
