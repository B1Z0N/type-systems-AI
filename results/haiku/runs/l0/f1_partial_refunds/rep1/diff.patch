diff --git a/tests/test_partial_refunds.py b/tests/test_partial_refunds.py
new file mode 100644
index 0000000..861eb13
--- /dev/null
+++ b/tests/test_partial_refunds.py
@@ -0,0 +1,127 @@
+import pytest
+
+from billing import api, ledger, refunds
+from billing.errors import InvalidStateError, ValidationError
+
+
+def _paid_invoice(world, quantity=1):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], quantity)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    return inv
+
+
+def _payments(world, invoice):
+    return world.ctx.store.payments_for_invoice(invoice["id"])
+
+
+def test_partial_refund_marks_payment_partially_refunded(world):
+    inv = _paid_invoice(world)
+    note = world.engine.refund(inv["id"], amount=300)
+    assert note["amount"] == 300
+    assert note["refunded"] is True
+    [payment] = _payments(world, inv)
+    assert payment["refunded_amount"] == 300
+    assert payment["status"] == "partially_refunded"
+    assert world.gateway.refunds == [(payment["gateway_ref"], 300)]
+    assert inv["status"] == "paid"
+
+
+def test_partial_refunds_until_exhausted(world):
+    inv = _paid_invoice(world)
+    world.engine.refund(inv["id"], amount=300)
+    world.engine.refund(inv["id"], amount=700)
+    [payment] = _payments(world, inv)
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 1000
+    assert len(world.ctx.store.credit_notes_for(inv["id"])) == 2
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"], amount=1)
+
+
+@pytest.mark.parametrize("amount", [0, -5])
+def test_non_positive_amount_rejected(world, amount):
+    inv = _paid_invoice(world)
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=amount)
+    assert world.gateway.refunds == []
+
+
+def test_amount_above_remaining_rejected(world):
+    inv = _paid_invoice(world)
+    world.engine.refund(inv["id"], amount=600)
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=500)
+    assert world.engine.refund(inv["id"], amount=400)["amount"] == 400
+
+
+def test_full_refund_after_partial_refunds_only_refunds_remainder(world):
+    inv = _paid_invoice(world)
+    world.engine.refund(inv["id"], amount=300)
+    note = world.engine.refund(inv["id"])
+    assert note["amount"] == 700
+    assert sum(amount for _, amount in world.gateway.refunds) == 1000
+    [payment] = _payments(world, inv)
+    assert payment["status"] == "refunded"
+
+
+def test_partial_refund_keeps_applied_credit(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], 200)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    assert inv["credit_applied"] == 200
+    world.engine.refund(inv["id"], amount=500)
+    assert ledger.balance(world.ctx, cus["id"]) == 0
+    note = world.engine.refund(inv["id"])
+    assert note["amount"] == 300 + 200
+    assert ledger.balance(world.ctx, cus["id"]) == 200
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+    assert ledger.balance(world.ctx, cus["id"]) == 200
+
+
+def test_oldest_payment_refunded_first(world):
+    inv = _paid_invoice(world)
+    [first] = _payments(world, inv)
+    # A second successful charge on the same invoice, created later than the first.
+    world.clock.advance_days(1)
+    second = {
+        "id": world.ctx.ids.payment(),
+        "invoice_id": inv["id"],
+        "customer_id": inv["customer_id"],
+        "method_id": None,
+        "amount": 500,
+        "currency": inv["currency"],
+        "status": "succeeded",
+        "refunded_amount": 0,
+        "gateway_ref": world.gateway.charge({"id": "pm", "last4": "4242"}, 500, "usd", "manual")["gateway_ref"],
+        "failure_code": None,
+        "created_at": world.clock.now(),
+    }
+    world.ctx.store.payments[second["id"]] = second
+    world.engine.refund(inv["id"], amount=1200)
+    assert first["status"] == "refunded"
+    assert first["refunded_amount"] == 1000
+    assert second["status"] == "partially_refunded"
+    assert second["refunded_amount"] == 200
+
+
+def test_credited_invoice_cannot_be_refunded_with_amount(world):
+    inv = _paid_invoice(world)
+    refunds.credit_invoice(world.ctx, inv["id"], 400, "goodwill")
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"], amount=100)
+
+
+def test_api_refund_accepts_amount(world):
+    inv = _paid_invoice(world)
+    status, body = api.handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": 250})
+    assert status == 200
+    assert body["amount"] == 250
+    status, body = api.handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": "250"})
+    assert status == 400
+    status, body = api.handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": 5000})
+    assert status == 400
