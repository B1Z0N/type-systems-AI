diff --git a/tests/test_usage.py b/tests/test_usage.py
new file mode 100644
index 0000000..7ec379f
--- /dev/null
+++ b/tests/test_usage.py
@@ -0,0 +1,36 @@
+from billing import catalog, customers
+from billing.clock import epoch
+from billing.usage import records_in_period
+
+
+def _metered_subscription(world, aggregation="last"):
+    price = catalog.create_price(
+        world.ctx, world.api["id"], "usd", "metered", unit_amount=2, usage_aggregation=aggregation
+    )
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(price["id"], 0)])
+    return sub, price
+
+
+def test_usage_is_stored_in_epoch_seconds(world):
+    sub, price = _metered_subscription(world)
+    t = epoch(2026, 1, 16, 9)
+    record = world.engine.report_usage(sub["id"], price["id"], 4, t * 1000 + 250)
+    assert record["timestamp"] == t * 1000 + 250
+    stored = world.ctx.store.usage_records[record["id"]]
+    assert stored["timestamp"] == t
+
+
+def test_sub_second_order_is_preserved_for_last(world):
+    sub, price = _metered_subscription(world, aggregation="last")
+    t = epoch(2026, 1, 16, 9)
+    world.engine.report_usage(sub["id"], price["id"], 5, t * 1000 + 900)
+    world.engine.report_usage(sub["id"], price["id"], 7, t * 1000 + 100)
+    records = records_in_period(world.ctx, sub["id"], price["id"], t - 60, t + 60)
+    assert [r["quantity"] for r in records] == [7, 5]
+
+
+def test_default_timestamp_is_now_in_milliseconds_to_clients(world):
+    sub, price = _metered_subscription(world)
+    record = world.engine.report_usage(sub["id"], price["id"], 1, None)
+    assert record["timestamp"] == world.clock.now() * 1000
