@@ -0,0 +1,12 @@
+from billing import catalog, reports
+
+
+def test_mrr_normalises_monthly_and_yearly_positively(world):
+    monthly_30 = catalog.create_price(world.ctx, world.plan["id"], "usd", "per_unit", unit_amount=3000)
+    yearly_120 = catalog.create_price(
+        world.ctx, world.team["id"], "usd", "per_unit", unit_amount=12000, interval="year"
+    )
+    world.engine.subscribe(world.customer(email="m@example.com")["id"], [(monthly_30["id"], 1)])
+    world.engine.subscribe(world.customer(email="y@example.com")["id"], [(yearly_120["id"], 1)])
+
+    assert reports.mrr(world.ctx) == {"usd": 4000}
