+from billing import catalog
+from billing.reports import mrr
+
+
+def test_mrr_adds_monthly_and_normalised_yearly(world):
+    yearly = catalog.create_price(world.ctx, world.team["id"], "usd", "per_unit", unit_amount=12000, interval="year")
+    world.engine.subscribe(world.customer()["id"], [(world.monthly["id"], 3)])
+    world.engine.subscribe(world.customer(email="b@example.com")["id"], [(yearly["id"], 1)])
+    assert mrr(world.ctx) == {"usd": 4000}
