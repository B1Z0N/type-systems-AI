diff --git a/tests/test_webhooks_reports_api.py b/tests/test_webhooks_reports_api.py
index b4b87fb..1fabe3e 100644
--- a/tests/test_webhooks_reports_api.py
+++ b/tests/test_webhooks_reports_api.py
@@ -55,3 +55,19 @@ def test_api_round_trip(world):
     status, err = handle(world.engine, "GET", "/invoices/in_999999")
     assert status == 404
     assert handle(world.engine, "POST", "/usage", {"subscription": sub["id"]})[0] == 400
+
+
+def test_metered_usage_billed_on_renewal(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1), (world.api_calls["id"], 0)])
+    sub = world.ctx.store.require_subscription(sub["id"])
+    now = world.clock.now()
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3, timestamp=(now + 60) * 1000)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 4, timestamp=(now + 120) * 1000)
+    world.clock.set(sub["current_period_end"])
+    world.engine.run_cycle()
+    invoice = world.ctx.store.invoices_for_subscription(sub["id"])[-1]
+    usage_lines = [line for line in invoice["lines"] if line["kind"] == "usage"]
+    assert len(usage_lines) == 1
+    assert usage_lines[0]["quantity"] == 7
+    assert usage_lines[0]["amount"] == 14
