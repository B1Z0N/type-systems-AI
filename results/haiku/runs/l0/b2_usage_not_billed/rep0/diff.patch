+++ b/tests/test_usage.py
@@ -0,0 +1,18 @@
+from billing.clock import to_millis
+from billing.usage import aggregate_usage
+
+from conftest import DAY
+
+
+def test_renewal_bills_usage_reported_in_millis(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 1)])
+    start = sub["current_period_start"]
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 7, timestamp=to_millis(start + DAY))
+
+    assert aggregate_usage(world.ctx, sub["id"], world.api_calls["id"], start, sub["current_period_end"]) == 7
+
+    world.clock.advance_days(40)
+    invoices = world.engine.run_cycle()
+    usage_lines = [line for inv in invoices for line in inv["lines"] if line["kind"] == "usage"]
+    assert [line["quantity"] for line in usage_lines] == [7]
