diff --git a/tests/test_net_terms.py b/tests/test_net_terms.py
new file mode 100644
index 0000000..a204d23
--- /dev/null
+++ b/tests/test_net_terms.py
@@ -0,0 +1,67 @@
+import pytest
+
+from billing import customers
+from billing.api import handle
+from billing.errors import ValidationError
+
+DAY = 86_400
+
+
+def test_default_net_terms_is_seven_days(world):
+    cus = world.customer()
+    assert cus["net_terms_days"] == 7
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    assert inv["due_at"] == inv["finalized_at"] + 7 * DAY
+    assert sub["status"] == "active"
+
+
+def test_finalize_uses_customer_current_terms(world):
+    cus = world.customer(card=False)
+    customers.update_customer(world.ctx, cus["id"], net_terms_days=30)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    assert inv["status"] == "open"
+    assert inv["due_at"] == inv["finalized_at"] + 30 * DAY
+
+
+def test_create_customer_accepts_net_terms(world):
+    cus = customers.create_customer(world.ctx, "b@example.com", "Bob", net_terms_days=14)
+    assert cus["net_terms_days"] == 14
+
+
+def test_zero_net_terms_is_allowed(world):
+    cus = world.customer()
+    customers.update_customer(world.ctx, cus["id"], net_terms_days=0)
+    assert cus["net_terms_days"] == 0
+
+
+@pytest.mark.parametrize("bad", [-1, 7.0, True])
+def test_invalid_net_terms_rejected_on_create(world, bad):
+    with pytest.raises(ValidationError):
+        customers.create_customer(world.ctx, "b@example.com", "Bob", net_terms_days=bad)
+
+
+def test_negative_net_terms_rejected_on_update(world):
+    cus = world.customer()
+    with pytest.raises(ValidationError):
+        customers.update_customer(world.ctx, cus["id"], net_terms_days=-3)
+    assert cus["net_terms_days"] == 7
+
+
+def test_api_create_customer_with_net_terms(world):
+    status, body = handle(world.engine, "POST", "/customers", {"email": "x@example.com", "name": "X", "net_terms_days": 45})
+    assert status == 201
+    assert body["net_terms_days"] == 45
+
+
+def test_api_create_customer_defaults_net_terms(world):
+    status, body = handle(world.engine, "POST", "/customers", {"email": "x@example.com", "name": "X"})
+    assert status == 201
+    assert body["net_terms_days"] == 7
+
+
+def test_api_negative_net_terms_is_400(world):
+    status, body = handle(world.engine, "POST", "/customers", {"email": "x@example.com", "name": "X", "net_terms_days": -1})
+    assert status == 400
+    assert "net_terms_days" in body["error"]
