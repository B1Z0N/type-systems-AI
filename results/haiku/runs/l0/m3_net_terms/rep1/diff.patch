diff --git a/tests/test_net_terms.py b/tests/test_net_terms.py
new file mode 100644
index 0000000..69936d6
--- /dev/null
+++ b/tests/test_net_terms.py
@@ -0,0 +1,55 @@
+import pytest
+
+from billing import customers, invoices
+from billing.api import handle
+from billing.errors import ValidationError
+
+DAY = 86_400
+
+
+def test_net_terms_defaults_to_seven_days(world):
+    cus = world.customer()
+    assert cus["net_terms_days"] == 7
+
+
+def test_create_customer_with_net_terms(world):
+    cus = customers.create_customer(world.ctx, "b@example.com", "Bo", net_terms_days=30)
+    assert cus["net_terms_days"] == 30
+
+
+def test_negative_net_terms_rejected(world):
+    with pytest.raises(ValidationError):
+        customers.create_customer(world.ctx, "b@example.com", "Bo", net_terms_days=-1)
+    cus = world.customer()
+    with pytest.raises(ValidationError):
+        customers.update_customer(world.ctx, cus["id"], net_terms_days=-5)
+    assert cus["net_terms_days"] == 7
+
+
+def test_api_rejects_negative_net_terms(world):
+    payload = {"email": "x@example.com", "name": "X", "net_terms_days": -1}
+    status, body = handle(world.engine, "POST", "/customers", payload)
+    assert status == 400
+    assert "net_terms_days" in body["error"]
+
+
+def test_api_create_customer_passes_net_terms(world):
+    payload = {"email": "x@example.com", "name": "X", "net_terms_days": 14}
+    status, cus = handle(world.engine, "POST", "/customers", payload)
+    assert status == 201
+    assert cus["net_terms_days"] == 14
+
+
+def test_finalize_uses_current_net_terms(world):
+    cus = world.customer(card=False)
+    subscription = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=0)
+    draft = invoices.build_draft(
+        world.ctx,
+        subscription,
+        subscription["current_period_start"],
+        subscription["current_period_end"],
+        None,
+    )
+    customers.update_customer(world.ctx, cus["id"], net_terms_days=30)
+    invoice = invoices.finalize(world.ctx, draft["id"])
+    assert invoice["due_at"] == invoice["finalized_at"] + 30 * DAY
