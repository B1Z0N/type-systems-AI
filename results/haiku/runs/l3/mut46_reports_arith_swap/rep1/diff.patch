+from billing import catalog
+from billing.reports import mrr
+
+
+def test_mrr_sums_monthly_and_yearly_subscriptions(world):
+    yearly = catalog.create_price(
+        world.ctx, world.plan["id"], "usd", "per_unit", unit_amount=12000, interval="year"
+    )
+    world.engine.subscribe(world.customer()["id"], [(world.team_monthly["id"], 1)])
+    world.engine.subscribe(world.customer(email="b@example.com")["id"], [(yearly["id"], 1)])
+    assert mrr(world.ctx) == {"usd": 4000}
