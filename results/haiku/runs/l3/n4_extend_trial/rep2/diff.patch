diff --git a/billing/subscriptions.py b/billing/subscriptions.py
index e0ff3b2..ecb5c89 100644
--- a/billing/subscriptions.py
+++ b/billing/subscriptions.py
@@ -209,6 +209,24 @@ def resume(ctx: Context, subscription_id: SubscriptionId) -> Subscription:
     return subscription
 
 
+def extend_trial(ctx: Context, subscription_id: SubscriptionId, days: int) -> Subscription:
+    """Push a trialing subscription's trial end and current period end back by whole days."""
+    if isinstance(days, bool) or not isinstance(days, int) or days <= 0:
+        raise ValidationError("days must be a positive integer")
+    subscription = ctx.store.require_subscription(subscription_id)
+    if subscription["status"] != "trialing" or subscription["trial_end"] is None:
+        raise InvalidStateError("only trialing subscriptions can have their trial extended")
+    extension = days * SECONDS_PER_DAY
+    subscription["trial_end"] = EpochSeconds(subscription["trial_end"] + extension)
+    subscription["current_period_end"] = EpochSeconds(subscription["current_period_end"] + extension)
+    emit(
+        ctx,
+        "subscription.updated",
+        {"subscription": subscription_json(subscription), "previous_status": subscription["status"]},
+    )
+    return subscription
+
+
 def advance_period(ctx: Context, subscription: Subscription) -> tuple[EpochSeconds, EpochSeconds]:
     """Roll the subscription into its next period and return the period that just ended."""
     ended = (subscription["current_period_start"], subscription["current_period_end"])
