@@ -209,6 +209,24 @@ def resume(ctx: Context, subscription_id: SubscriptionId) -> Subscription:
     return subscription
 
 
+def extend_trial(ctx: Context, subscription_id: SubscriptionId, days: int) -> Subscription:
+    """Push the end of a trialing subscription's trial back by whole days."""
+    if isinstance(days, bool) or not isinstance(days, int) or days <= 0:
+        raise ValidationError("days must be a positive integer")
+    subscription = ctx.store.require_subscription(subscription_id)
+    if subscription["status"] != "trialing" or subscription["trial_end"] is None:
+        raise InvalidStateError("only trialing subscriptions can have their trial extended")
+    shift = days * SECONDS_PER_DAY
+    subscription["trial_end"] = EpochSeconds(subscription["trial_end"] + shift)
+    subscription["current_period_end"] = EpochSeconds(subscription["current_period_end"] + shift)
+    emit(
+        ctx,
+        "subscription.updated",
+        {"subscription": subscription_json(subscription), "previous_status": subscription["status"]},
+    )
+    return subscription
+
+
 def advance_period(ctx: Context, subscription: Subscription) -> tuple[EpochSeconds, EpochSeconds]:
     """Roll the subscription into its next period and return the period that just ended."""
     ended = (subscription["current_period_start"], subscription["current_period_end"])
diff --git a/tests/test_extend_trial.py b/tests/test_extend_trial.py
new file mode 100644
index 0000000..33b25f9
--- /dev/null
+++ b/tests/test_extend_trial.py
@@ -0,0 +1,47 @@
+import pytest
+from billing import subscriptions
+from billing.errors import InvalidStateError, ValidationError
+from billing.events import events_of_type
+from billing.models import SECONDS_PER_DAY
+
+
+def test_extend_trial_moves_end_and_bills_later(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    before = sub["current_period_end"]
+    subscriptions.extend_trial(world.ctx, sub["id"], 7)
+    assert sub["trial_end"] == before + 7 * SECONDS_PER_DAY
+    assert sub["current_period_end"] == before + 7 * SECONDS_PER_DAY
+    assert world.engine.invoices_for(cus["id"]) == []
+    world.advance_days(14)
+    assert sub["status"] == "trialing"
+    assert world.engine.invoices_for(cus["id"]) == []
+    world.advance_days(7)
+    assert sub["status"] == "active"
+    [inv] = world.engine.invoices_for(cus["id"])
+    assert inv["total"] == 1000
+
+
+def test_extend_trial_emits_event(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    before = len(events_of_type(world.ctx, "subscription.updated"))
+    subscriptions.extend_trial(world.ctx, sub["id"], 3)
+    updated = events_of_type(world.ctx, "subscription.updated")
+    assert len(updated) == before + 1
+    assert updated[-1]["payload"]["subscription"]["id"] == sub["id"]
+
+
+@pytest.mark.parametrize("bad", [0, -1, 1.5, True, "3", None])
+def test_extend_trial_rejects_bad_days(world, bad):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    with pytest.raises(ValidationError):
+        subscriptions.extend_trial(world.ctx, sub["id"], bad)
+
+
+def test_extend_trial_requires_trialing(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    with pytest.raises(InvalidStateError):
+        subscriptions.extend_trial(world.ctx, sub["id"], 3)
