diff --git a/tests/test_net_terms.py b/tests/test_net_terms.py
new file mode 100644
index 0000000..2416a80
--- /dev/null
+++ b/tests/test_net_terms.py
@@ -0,0 +1,58 @@
+import pytest
+
+from billing import customers, invoices
+from billing.api import handle
+from billing.clock import epoch
+from billing.errors import ValidationError
+from billing.models import SECONDS_PER_DAY
+
+START = epoch(2026, 1, 15, 12)
+
+
+def test_default_net_terms_is_seven_days(world):
+    cus = world.customer()
+    assert cus["net_terms_days"] == 7
+
+
+def test_create_customer_with_custom_terms(world):
+    cus = customers.create_customer(world.ctx, "b@example.com", "Bob", net_terms_days=30)
+    assert cus["net_terms_days"] == 30
+
+
+def test_negative_net_terms_rejected(world):
+    with pytest.raises(ValidationError):
+        customers.create_customer(world.ctx, "b@example.com", "Bob", net_terms_days=-1)
+    cus = world.customer()
+    with pytest.raises(ValidationError):
+        customers.update_customer(world.ctx, cus["id"], net_terms_days=-5)
+    assert cus["net_terms_days"] == 7
+
+
+def test_finalize_uses_current_terms(world):
+    cus = world.customer()
+    draft = invoices.create_one_off(world.ctx, cus["id"], [("Setup", 1000, 1)])
+    customers.update_customer(world.ctx, cus["id"], net_terms_days=21)
+    finalized = invoices.finalize(world.ctx, draft["id"])
+    assert finalized["due_at"] == START + 21 * SECONDS_PER_DAY
+
+
+def test_api_create_customer_with_net_terms(world):
+    status, body = handle(
+        world.engine, "POST", "/customers", {"email": "x@example.com", "name": "X", "net_terms_days": 14}
+    )
+    assert status == 201
+    assert body["net_terms_days"] == 14
+
+
+def test_api_default_net_terms(world):
+    status, body = handle(world.engine, "POST", "/customers", {"email": "x@example.com", "name": "X"})
+    assert status == 201
+    assert body["net_terms_days"] == 7
+
+
+def test_api_negative_net_terms_is_400(world):
+    status, body = handle(
+        world.engine, "POST", "/customers", {"email": "x@example.com", "name": "X", "net_terms_days": -3}
+    )
+    assert status == 400
+    assert "negative" in body["error"]
