diff --git a/tests/test_partial_refunds.py b/tests/test_partial_refunds.py
new file mode 100644
index 0000000..1b0a28a
--- /dev/null
+++ b/tests/test_partial_refunds.py
@@ -0,0 +1,116 @@
+import pytest
+
+from billing import ledger
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
+
+
+def _paid_invoice(world, quantity=2):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], quantity)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    return cus, inv
+
+
+def test_partial_refunds_then_remainder(world):
+    _, inv = _paid_invoice(world)
+    [payment] = world.ctx.store.payments_for_invoice(inv["id"])
+
+    note = world.engine.refund(inv["id"], amount=500)
+    assert note["amount"] == 500 and note["refunded"] is True
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 500
+    assert world.gateway.refunds == [(payment["gateway_ref"], 500)]
+
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=1600)
+
+    note = world.engine.refund(inv["id"])
+    assert note["amount"] == 1500
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 2000
+    assert len(world.ctx.store.credit_notes_for(inv["id"])) == 2
+
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"], amount=100)
+
+
+def test_amount_must_be_positive(world):
+    _, inv = _paid_invoice(world, quantity=1)
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=0)
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=-5)
+    assert world.ctx.store.credit_notes_for(inv["id"]) == []
+
+
+def test_partial_refund_keeps_applied_credit_until_full_refund(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], 700)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    assert inv["credit_applied"] == 700
+
+    world.engine.refund(inv["id"], amount=100)
+    assert ledger.balance(world.ctx, cus["id"]) == 0
+
+    note = world.engine.refund(inv["id"])
+    assert note["amount"] == 200 + 700
+    assert ledger.balance(world.ctx, cus["id"]) == 700
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+    assert ledger.balance(world.ctx, cus["id"]) == 700
+
+
+def test_full_refund_returns_credit_without_partial_refunds(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], 700)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    note = world.engine.refund(inv["id"])
+    assert note["amount"] == 1000
+    assert ledger.balance(world.ctx, cus["id"]) == 700
+
+
+def test_explicit_amount_does_not_return_credit(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], 700)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    world.engine.refund(inv["id"], amount=300)
+    assert ledger.balance(world.ctx, cus["id"]) == 0
+
+
+def test_refund_takes_oldest_payment_first(world):
+    cus, inv = _paid_invoice(world)
+    [first] = world.ctx.store.payments_for_invoice(inv["id"])
+    [method] = world.ctx.store.payment_methods_for(cus["id"])
+    charge = world.gateway.charge(method, 800, "usd", "second-charge")
+    second = {
+        **first,
+        "id": world.ctx.ids.payment(),
+        "amount": 800,
+        "gateway_ref": charge["gateway_ref"],
+        "refunded_amount": 0,
+        "created_at": first["created_at"] + 1,
+    }
+    world.ctx.store.payments[second["id"]] = second
+
+    world.engine.refund(inv["id"], amount=500)
+    assert first["refunded_amount"] == 500 and first["status"] == "partially_refunded"
+    assert second["refunded_amount"] == 0 and second["status"] == "succeeded"
+
+    world.engine.refund(inv["id"], amount=1800)
+    assert first["refunded_amount"] == 2000 and first["status"] == "refunded"
+    assert second["refunded_amount"] == 300 and second["status"] == "partially_refunded"
+
+
+def test_refund_endpoint_accepts_amount(world):
+    _, inv = _paid_invoice(world)
+    status, body = handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": 500})
+    assert status == 200
+    assert body["amount"] == 500
+    status, body = handle(world.engine, "POST", f"/invoices/{inv['id']}/refund", {"amount": True})
+    assert status >= 400
