diff --git a/tests/test_refunds.py b/tests/test_refunds.py
new file mode 100644
index 0000000..e9e51af
--- /dev/null
+++ b/tests/test_refunds.py
@@ -0,0 +1,102 @@
+import pytest
+
+from billing import customers, ledger, refunds
+from billing.errors import InvalidStateError, ValidationError
+
+
+def _paid_invoice(world):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    return cus, inv
+
+
+def test_partial_refund_marks_payment_partially_refunded(world):
+    _, inv = _paid_invoice(world)
+    [payment] = world.ctx.store.payments_for_invoice(inv["id"])
+
+    note = world.engine.refund(inv["id"], amount=300)
+
+    assert note["amount"] == 300
+    assert note["refunded"] is True
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 300
+    assert world.gateway.refunds == [(payment["gateway_ref"], 300)]
+
+
+def test_several_partial_refunds_then_remainder(world):
+    _, inv = _paid_invoice(world)
+    [payment] = world.ctx.store.payments_for_invoice(inv["id"])
+
+    world.engine.refund(inv["id"], amount=300)
+    world.engine.refund(inv["id"], amount=200)
+    last = world.engine.refund(inv["id"])
+
+    assert last["amount"] == 500
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 1000
+    assert len(world.ctx.store.credit_notes_for(inv["id"])) == 3
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+
+
+def test_full_refund_after_partial_refunds_only_refunds_remainder(world):
+    _, inv = _paid_invoice(world)
+
+    world.engine.refund(inv["id"], amount=400)
+    note = world.engine.refund(inv["id"])
+
+    assert note["amount"] == 600
+    assert [amount for _, amount in world.gateway.refunds] == [400, 600]
+
+
+@pytest.mark.parametrize("amount", [0, -1])
+def test_non_positive_amount_is_rejected(world, amount):
+    _, inv = _paid_invoice(world)
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=amount)
+
+
+def test_amount_above_remaining_is_rejected(world):
+    _, inv = _paid_invoice(world)
+    world.engine.refund(inv["id"], amount=800)
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=201)
+    assert world.engine.refund(inv["id"], amount=200)["amount"] == 200
+
+
+def test_partial_refund_takes_oldest_payment_first(world):
+    cus, inv = _paid_invoice(world)
+    [first] = world.ctx.store.payments_for_invoice(inv["id"])
+    # A second successful payment on the same invoice, inserted after but created before the first.
+    method = world.ctx.store.payment_methods_for(cus["id"])[0]
+    ref = world.ctx.gateway.charge(method, 500, "usd", "second")["gateway_ref"]
+    second = dict(first, id="py_second", amount=500, refunded_amount=0, gateway_ref=ref)
+    second["created_at"] = first["created_at"] - 1
+    world.ctx.store.payments[second["id"]] = second
+
+    world.engine.refund(inv["id"], amount=300)
+
+    assert second["refunded_amount"] == 300
+    assert second["status"] == "partially_refunded"
+    assert first["refunded_amount"] == 0
+    assert first["status"] == "succeeded"
+
+
+def test_partial_refund_does_not_return_account_credit(world):
+    cus, inv = _paid_invoice(world)
+    inv["credit_applied"] = 100
+    ledger.grant_credit(world.ctx, cus["id"], 100)
+
+    world.engine.refund(inv["id"], amount=300)
+    assert ledger.balance(world.ctx, cus["id"]) == 100
+
+    world.engine.refund(inv["id"])
+    assert ledger.balance(world.ctx, cus["id"]) == 200
+
+
+def test_account_credit_issued_blocks_refund(world):
+    _, inv = _paid_invoice(world)
+    refunds.credit_invoice(world.ctx, inv["id"], 400, "goodwill")
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"], amount=100)
