diff --git a/tests/test_usage_units.py b/tests/test_usage_units.py
new file mode 100644
index 0000000..4b514b6
--- /dev/null
+++ b/tests/test_usage_units.py
@@ -0,0 +1,43 @@
+from billing import usage
+from billing.api import handle
+from billing.clock import epoch
+
+
+def _subscribe_metered(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    return sub["id"]
+
+
+def test_usage_timestamp_stored_in_seconds(world):
+    sub_id = _subscribe_metered(world)
+    record = world.engine.report_usage(sub_id, world.api_calls["id"], 5, 1_700_000_000_750)
+    assert record["timestamp"] == 1_700_000_000
+    default = world.engine.report_usage(sub_id, world.api_calls["id"], 1)
+    assert default["timestamp"] == world.clock.now()
+
+
+def test_api_returns_timestamp_in_milliseconds(world):
+    sub_id = _subscribe_metered(world)
+    status, body = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {"subscription": sub_id, "price": world.api_calls["id"], "quantity": 1, "timestamp": 1_700_000_000_000},
+    )
+    assert status == 201 and body["timestamp"] == 1_700_000_000_000
+
+
+def test_period_boundaries_unchanged_by_sub_second_timestamps(world):
+    sub_id = _subscribe_metered(world)
+    start = epoch(2026, 2, 1)
+    end = epoch(2026, 3, 1)
+    price_id = world.api_calls["id"]
+    before = world.engine.report_usage(sub_id, price_id, 1, start * 1000 - 1)
+    inside = world.engine.report_usage(sub_id, price_id, 2, start * 1000 + 500)
+    last_inside = world.engine.report_usage(sub_id, price_id, 4, end * 1000 - 1)
+    after = world.engine.report_usage(sub_id, price_id, 8, end * 1000)
+    ids = {record["id"] for record in usage.records_in_period(world.ctx, sub_id, price_id, start, end)}
+    assert ids == {inside["id"], last_inside["id"]}
+    assert before["id"] not in ids and after["id"] not in ids
+    assert usage.aggregate_usage(world.ctx, sub_id, price_id, start, end) == 6
