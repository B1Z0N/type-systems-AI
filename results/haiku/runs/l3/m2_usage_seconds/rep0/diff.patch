diff --git a/tests/test_usage_timestamps.py b/tests/test_usage_timestamps.py
new file mode 100644
index 0000000..6b00e25
--- /dev/null
+++ b/tests/test_usage_timestamps.py
@@ -0,0 +1,47 @@
+from billing import usage
+from billing.api import handle
+from billing.clock import epoch
+
+DAY = 86_400
+
+
+def _metered_sub(world, price_id):
+    cus = world.customer()
+    return world.engine.subscribe(cus["id"], [(price_id, 0)])
+
+
+def test_usage_is_stored_in_seconds_and_accepts_millis(world):
+    sub = _metered_sub(world, world.api_calls["id"])
+    at = world.clock.now() + 5
+    rec = world.engine.report_usage(sub["id"], world.api_calls["id"], 3, at * 1000)
+    assert rec["timestamp"] == at
+
+
+def test_default_timestamp_is_now_in_seconds(world):
+    sub = _metered_sub(world, world.api_calls["id"])
+    rec = world.engine.report_usage(sub["id"], world.api_calls["id"], 1)
+    assert rec["timestamp"] == world.clock.now()
+
+
+def test_api_echoes_timestamp_in_millis(world):
+    sub = _metered_sub(world, world.api_calls["id"])
+    at_ms = (world.clock.now() + 60) * 1000
+    status, body = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {"subscription": sub["id"], "price": world.api_calls["id"], "quantity": 1, "timestamp": at_ms},
+    )
+    assert status == 201 and body["timestamp"] == at_ms
+
+
+def test_period_bounds_are_half_open_in_seconds(world):
+    sub = _metered_sub(world, world.api_calls["id"])
+    start = epoch(2026, 2, 1)
+    end = start + DAY
+    price_id = world.api_calls["id"]
+    world.engine.report_usage(sub["id"], price_id, 1, (start - 1) * 1000)
+    world.engine.report_usage(sub["id"], price_id, 2, start * 1000)
+    world.engine.report_usage(sub["id"], price_id, 4, (end - 1) * 1000)
+    world.engine.report_usage(sub["id"], price_id, 8, end * 1000)
+    assert usage.aggregate_usage(world.ctx, sub["id"], price_id, start, end) == 6
