diff --git a/tests/test_usage.py b/tests/test_usage.py
new file mode 100644
index 0000000..628b81b
--- /dev/null
+++ b/tests/test_usage.py
@@ -0,0 +1,22 @@
+from billing.api import handle
+from billing.clock import epoch
+from billing.usage import records_in_period
+
+
+def test_usage_timestamp_stored_in_seconds_and_echoed_in_millis(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 1)])
+    start = epoch(2026, 1, 15, 12)
+    millis = (start + 5) * 1000 + 250
+
+    status, body = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {"subscription": sub["id"], "price": world.api_calls["id"], "quantity": 4, "timestamp": millis},
+    )
+    assert status == 201 and body["timestamp"] == millis
+
+    (record,) = records_in_period(world.ctx, sub["id"], world.api_calls["id"], start, start + 60)
+    assert record["timestamp"] == start + 5
+    assert record["subsecond_ms"] == 250
