diff --git a/tests/test_usage_timestamp_units.py b/tests/test_usage_timestamp_units.py
new file mode 100644
index 0000000..3d6edd9
--- /dev/null
+++ b/tests/test_usage_timestamp_units.py
@@ -0,0 +1,60 @@
+from billing import catalog, usage
+from billing.api import handle
+
+
+def test_usage_stores_seconds_and_api_returns_original_milliseconds(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 1)])
+    milliseconds = world.clock.now() * 1000 + 789
+
+    record = world.engine.report_usage(subscription["id"], world.api_calls["id"], 3, milliseconds)
+    assert record["timestamp"] == world.clock.now()
+    assert world.ctx.store.usage_records[record["id"]]["timestamp"] == world.clock.now()
+
+    status, response = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {
+            "subscription": subscription["id"],
+            "price": world.api_calls["id"],
+            "quantity": 4,
+            "timestamp": milliseconds,
+            "idempotency_key": "same-usage",
+        },
+    )
+    assert status == 201
+    assert response["timestamp"] == milliseconds
+    assert world.ctx.store.usage_records[response["id"]]["timestamp"] == world.clock.now()
+
+    status, repeated = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {
+            "subscription": subscription["id"],
+            "price": world.api_calls["id"],
+            "quantity": 99,
+            "idempotency_key": "same-usage",
+        },
+    )
+    assert status == 201
+    assert repeated == response
+
+
+def test_usage_period_boundaries_and_last_keep_millisecond_order(world):
+    customer = world.customer()
+    price = catalog.create_price(
+        world.ctx, world.api["id"], "usd", "metered", unit_amount=2, usage_aggregation="last"
+    )
+    subscription = world.engine.subscribe(customer["id"], [(price["id"], 1)])
+    start = subscription["current_period_start"]
+    end = subscription["current_period_end"]
+
+    usage.report_usage(world.ctx, subscription["id"], price["id"], 9, start * 1000 - 1)
+    usage.report_usage(world.ctx, subscription["id"], price["id"], 2, start * 1000 + 900)
+    usage.report_usage(world.ctx, subscription["id"], price["id"], 3, start * 1000 + 100)
+    usage.report_usage(world.ctx, subscription["id"], price["id"], 8, end * 1000)
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], price["id"], start, end) == 2
+    assert [record["quantity"] for record in usage.records_in_period(world.ctx, subscription["id"], price["id"], start, end)] == [3, 2]
