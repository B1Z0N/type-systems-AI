diff --git a/tests/test_usage_seconds.py b/tests/test_usage_seconds.py
new file mode 100644
index 0000000..4439f58
--- /dev/null
+++ b/tests/test_usage_seconds.py
@@ -0,0 +1,56 @@
+from billing import catalog, usage
+from billing.api import handle
+
+
+def test_usage_reporting_stores_seconds_and_returns_milliseconds(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    milliseconds = world.clock.now() * 1000 + 123
+
+    reported = usage.report_usage(world.ctx, subscription["id"], world.api_calls["id"], 2, milliseconds)
+    stored = world.ctx.store.usage_records[reported["id"]]
+    assert reported["timestamp"] == milliseconds
+    assert stored["timestamp"] == world.clock.now()
+
+    duplicate = world.engine.report_usage(subscription["id"], world.api_calls["id"], 9, idempotency_key="other")
+    assert duplicate["timestamp"] == world.clock.now() * 1000
+    assert world.ctx.store.usage_records[duplicate["id"]]["timestamp"] == world.clock.now()
+
+    status, response = handle(world.engine, "POST", "/usage", {
+        "subscription": subscription["id"],
+        "price": world.api_calls["id"],
+        "quantity": 3,
+        "timestamp": milliseconds + 1,
+        "idempotency_key": "api-usage",
+    })
+    assert status == 201
+    assert response["timestamp"] == milliseconds + 1
+    assert world.ctx.store.usage_records[response["id"]]["timestamp"] == world.clock.now()
+    status, replay = handle(world.engine, "POST", "/usage", {
+        "subscription": subscription["id"],
+        "price": world.api_calls["id"],
+        "quantity": 99,
+        "idempotency_key": "api-usage",
+    })
+    assert status == 201
+    assert replay == response
+
+
+def test_usage_period_and_last_aggregation_preserve_millisecond_order(world):
+    last_price = catalog.create_price(
+        world.ctx, world.api["id"], "usd", "metered", unit_amount=2, usage_aggregation="last"
+    )
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(last_price["id"], 0)])
+    start = subscription["current_period_start"]
+    end = subscription["current_period_end"]
+
+    world.engine.report_usage(subscription["id"], last_price["id"], 1, start * 1000 - 1)
+    world.engine.report_usage(subscription["id"], last_price["id"], 4, start * 1000 + 900)
+    world.engine.report_usage(subscription["id"], last_price["id"], 9, start * 1000 + 100)
+    world.engine.report_usage(subscription["id"], last_price["id"], 7, end * 1000)
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], last_price["id"], start, end) == 4
+    world.clock.advance(end - start)
+    [invoice] = world.engine.run_cycle()
+    assert [line["amount"] for line in invoice["lines"] if line["kind"] == "usage"] == [8]
