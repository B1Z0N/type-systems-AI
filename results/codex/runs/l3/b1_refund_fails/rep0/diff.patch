+
+
+def test_refund_uses_payments_for_the_requested_invoice(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    first_invoice = world.engine.invoices_for(customer["id"])[0]
+    world.engine.subscribe(customer["id"], [(world.team_monthly["id"], 1)])
+    second_invoice = world.engine.invoices_for(customer["id"])[1]
+    first_payment = world.ctx.store.payments_for_invoice(first_invoice["id"])[0]
+    second_payment = world.ctx.store.payments_for_invoice(second_invoice["id"])[0]
+
+    note = world.engine.refund(first_invoice["id"])
+
+    assert note["invoice_id"] == first_invoice["id"]
+    assert note["amount"] == first_payment["amount"]
+    assert world.gateway.refunds == [(first_payment["gateway_ref"], first_payment["amount"])]
+    assert first_payment["status"] == "refunded"
+    assert second_payment["status"] == "succeeded"
+    assert second_payment["refunded_amount"] == 0
