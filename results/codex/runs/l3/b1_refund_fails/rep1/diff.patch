+def test_refund_paid_invoice_only_refunds_its_payment(world):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    world.engine.subscribe(cus["id"], [(world.team_monthly["id"], 1)])
+    first, second = world.engine.invoices_for(cus["id"])
+    [first_payment] = world.ctx.store.payments_for_invoice(first["id"])
+    [second_payment] = world.ctx.store.payments_for_invoice(second["id"])
+
+    note = world.engine.refund(first["id"])
+
+    assert note["amount"] == 1000
+    assert world.gateway.refunds == [(first_payment["gateway_ref"], 1000)]
+    assert first_payment["status"] == "refunded"
+    assert second_payment["status"] == "succeeded"
