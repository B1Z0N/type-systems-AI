+
+
+def test_declined_card_retries_only_on_dunning_schedule(world):
+    customer = world.customer(last4="0002")
+    subscription = world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+
+    assert invoice["attempt_count"] == 1
+    assert subscription["status"] == "past_due"
+    for day, expected_attempts in enumerate((1, 2, 2, 3, 3, 3, 3, 4, 4)):
+        if day:
+            world.advance_days(1)
+        world.engine.run_cycle()
+        assert invoice["attempt_count"] == expected_attempts
+        assert len(world.gateway.charges) == expected_attempts
+        assert subscription["status"] == ("unpaid" if day >= 7 else "past_due")
+    assert invoice["next_attempt_at"] is None
