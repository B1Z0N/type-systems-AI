diff --git a/tests/test_net_terms.py b/tests/test_net_terms.py
new file mode 100644
index 0000000..9541e0d
--- /dev/null
+++ b/tests/test_net_terms.py
@@ -0,0 +1,48 @@
+import pytest
+
+from billing import customers, invoices
+from billing.api import handle
+from billing.errors import ValidationError
+
+DAY = 86_400
+
+
+def test_customer_terms_apply_at_invoice_finalization(world):
+    customer = customers.create_customer(world.ctx, "terms@example.com", "Terms", net_terms_days=30)
+    draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 1000, 1)])
+    customers.update_customer(world.ctx, customer["id"], net_terms_days=14)
+    finalized = invoices.finalize(world.ctx, draft["id"])
+    assert finalized["due_at"] == finalized["finalized_at"] + 14 * DAY
+
+    customers.update_customer(world.ctx, customer["id"], net_terms_days=0)
+    next_draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 1000, 1)])
+    next_invoice = invoices.finalize(world.ctx, next_draft["id"])
+    assert next_invoice["due_at"] == next_invoice["finalized_at"]
+    assert finalized["due_at"] == finalized["finalized_at"] + 14 * DAY
+
+
+def test_customer_terms_default_and_validation(world):
+    customer = customers.create_customer(world.ctx, "default@example.com", "Default")
+    assert customer["net_terms_days"] == 7
+    draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 1000, 1)])
+    invoice = invoices.finalize(world.ctx, draft["id"])
+    assert invoice["due_at"] == invoice["finalized_at"] + 7 * DAY
+
+    for invalid in (-1, True, 1.5):
+        with pytest.raises(ValidationError):
+            customers.create_customer(world.ctx, "bad@example.com", "Bad", net_terms_days=invalid)
+        with pytest.raises(ValidationError):
+            customers.update_customer(world.ctx, customer["id"], net_terms_days=invalid)
+    assert customer["net_terms_days"] == 7
+
+
+def test_api_customer_terms(world):
+    body = {"email": "api@example.com", "name": "API", "net_terms_days": 21}
+    status, response = handle(world.engine, "POST", "/customers", body)
+    assert status == 201
+    assert response["net_terms_days"] == 21
+    assert world.ctx.store.require_customer(response["id"])["net_terms_days"] == 21
+
+    for invalid in (-1, True, "21"):
+        status, _ = handle(world.engine, "POST", "/customers", {**body, "net_terms_days": invalid})
+        assert status == 400
