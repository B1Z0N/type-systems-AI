diff --git a/tests/test_net_terms.py b/tests/test_net_terms.py
new file mode 100644
index 0000000..0d9efdf
--- /dev/null
+++ b/tests/test_net_terms.py
@@ -0,0 +1,53 @@
+import pytest
+
+from billing import customers, invoices
+from billing.api import handle
+from billing.errors import ValidationError
+from billing.models import SECONDS_PER_DAY
+
+
+def test_default_and_custom_terms_set_invoice_due_date(world):
+    default = customers.create_customer(world.ctx, "default@example.com", "Default")
+    custom = customers.create_customer(world.ctx, "custom@example.com", "Custom", net_terms_days=30)
+
+    assert default["net_terms_days"] == 7
+    assert custom["net_terms_days"] == 30
+    for customer, days in ((default, 7), (custom, 30)):
+        draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+        final = invoices.finalize(world.ctx, draft["id"])
+        assert final["due_at"] == final["finalized_at"] + days * SECONDS_PER_DAY
+
+
+def test_invoice_uses_customer_term_at_finalization(world):
+    customer = customers.create_customer(world.ctx, "x@example.com", "X", net_terms_days=30)
+    draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+    customers.update_customer(world.ctx, customer["id"], net_terms_days=0)
+
+    final = invoices.finalize(world.ctx, draft["id"])
+    assert final["due_at"] == final["finalized_at"]
+
+
+@pytest.mark.parametrize("value", [-1, True, 1.5, "7"])
+def test_invalid_terms_raise_validation_error(world, value):
+    with pytest.raises(ValidationError):
+        customers.create_customer(world.ctx, "x@example.com", "X", net_terms_days=value)
+
+    customer = customers.create_customer(world.ctx, "valid@example.com", "Valid")
+    with pytest.raises(ValidationError):
+        customers.update_customer(world.ctx, customer["id"], net_terms_days=value)
+    assert customer["net_terms_days"] == 7
+
+
+def test_api_accepts_terms_and_rejects_invalid_values(world):
+    status, body = handle(world.engine, "POST", "/customers", {
+        "email": "x@example.com", "name": "X", "net_terms_days": 14,
+    })
+    assert status == 201
+    assert body["net_terms_days"] == 14
+    assert world.ctx.store.require_customer(body["id"])["net_terms_days"] == 14
+
+    for value in (-1, True, "7"):
+        status, _ = handle(world.engine, "POST", "/customers", {
+            "email": "bad@example.com", "name": "Bad", "net_terms_days": value,
+        })
+        assert status == 400
