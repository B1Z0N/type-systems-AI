diff --git a/tests/test_credit_notes.py b/tests/test_credit_notes.py
index 26befa7..054e12a 100644
--- a/tests/test_credit_notes.py
+++ b/tests/test_credit_notes.py
@@ -1,6 +1,9 @@
 import pytest
 
 from billing import ledger, refunds
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
+from billing.models import Cents
 
 
 def test_credit_note_limits(world):
@@ -11,3 +14,93 @@ def test_credit_note_limits(world):
     assert ledger.balance(world.ctx, cus["id"]) == 400
     with pytest.raises(Exception):
         refunds.credit_invoice(world.ctx, inv["id"], 700, "too much")
+
+
+def test_partial_refunds_and_remaining_full_refund(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [payment] = world.ctx.store.payments_for_invoice(invoice["id"])
+
+    first = world.engine.refund(invoice["id"], amount=Cents(250))
+    assert first["amount"] == 250 and first["refunded"] is True
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 250
+
+    second = refunds.refund_invoice(world.ctx, invoice["id"], amount=Cents(300))
+    assert second["amount"] == 300
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 550
+
+    last = world.engine.refund(invoice["id"])
+    assert last["amount"] == 450
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 1000
+    assert [amount for _, amount in world.gateway.refunds] == [250, 300, 450]
+    assert [note["amount"] for note in world.ctx.store.credit_notes_for(invoice["id"])] == [250, 300, 450]
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_partial_refund_validation_does_not_touch_gateway(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    for amount in (0, -1, 1001):
+        with pytest.raises(ValidationError):
+            world.engine.refund(invoice["id"], amount=Cents(amount))
+    assert world.gateway.refunds == []
+    world.engine.refund(invoice["id"], amount=Cents(600))
+    with pytest.raises(ValidationError):
+        world.engine.refund(invoice["id"], amount=Cents(401))
+    assert [amount for _, amount in world.gateway.refunds] == [600]
+
+
+def test_full_refund_returns_applied_credit_once_after_partial_refund(world):
+    customer = world.customer()
+    ledger.grant_credit(world.ctx, customer["id"], Cents(300))
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    assert invoice["credit_applied"] == 300
+
+    assert world.engine.refund(invoice["id"], amount=Cents(200))["amount"] == 200
+    assert ledger.balance(world.ctx, customer["id"]) == 0
+    assert world.engine.refund(invoice["id"])["amount"] == 800
+    assert ledger.balance(world.ctx, customer["id"]) == 300
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_api_accepts_integer_amount(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    path = f"/invoices/{invoice['id']}/refund"
+    assert handle(world.engine, "POST", path, {"amount": 125})[1]["amount"] == 125
+    assert handle(world.engine, "POST", path, {"amount": True})[0] == 400
+    assert handle(world.engine, "POST", path, {"amount": 0})[0] == 400
+    assert handle(world.engine, "POST", path, {})[1]["amount"] == 875
+
+
+def test_refund_uses_oldest_successful_payment_first(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [later_payment] = world.ctx.store.payments_for_invoice(invoice["id"])
+    later_payment["amount"] = Cents(400)
+    method = world.ctx.store.payment_methods_for(customer["id"])[0]
+    charge = world.gateway.charge(method, Cents(600), invoice["currency"], "second-payment")
+    older_payment = {
+        **later_payment,
+        "id": world.ctx.ids.payment(),
+        "amount": Cents(600),
+        "gateway_ref": charge["gateway_ref"],
+        "created_at": later_payment["created_at"] - 1,
+    }
+    world.ctx.store.payments[older_payment["id"]] = older_payment
+
+    world.engine.refund(invoice["id"], amount=Cents(750))
+    assert world.gateway.refunds == [(charge["gateway_ref"], 600), (later_payment["gateway_ref"], 150)]
+    assert older_payment["status"] == "refunded"
+    assert later_payment["status"] == "partially_refunded"
+    assert later_payment["refunded_amount"] == 150
