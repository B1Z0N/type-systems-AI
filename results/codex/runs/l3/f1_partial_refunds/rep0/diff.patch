 import pytest
 
 from billing import ledger, refunds
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
 
 
 def test_credit_note_limits(world):
@@ -11,3 +13,70 @@ def test_credit_note_limits(world):
     assert ledger.balance(world.ctx, cus["id"]) == 400
     with pytest.raises(Exception):
         refunds.credit_invoice(world.ctx, inv["id"], 700, "too much")
+
+
+def test_partial_refunds_then_refund_remainder(world):
+    customer = world.customer()
+    ledger.grant_credit(world.ctx, customer["id"], 200)
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [payment] = world.ctx.store.payments_for_invoice(invoice["id"])
+
+    first = world.engine.refund(invoice["id"], amount=300)
+    second = refunds.refund_invoice(world.ctx, invoice["id"], amount=100)
+    assert [first["amount"], second["amount"]] == [300, 100]
+    assert first["refunded"] and second["refunded"]
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 400
+    assert ledger.balance(world.ctx, customer["id"]) == 0
+
+    final = world.engine.refund(invoice["id"])
+    assert final["amount"] == 600  # 400 from the card and 200 of applied credit
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 800
+    assert ledger.balance(world.ctx, customer["id"]) == 200
+    assert [amount for _, amount in world.gateway.refunds] == [300, 100, 400]
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_amount_validation_and_api(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    for amount in (0, -1, 1001, True):
+        with pytest.raises(ValidationError):
+            world.engine.refund(invoice["id"], amount=amount)
+    assert world.gateway.refunds == []
+
+    path = f"/invoices/{invoice['id']}/refund"
+    assert handle(world.engine, "POST", path, {"amount": "100"})[0] == 400
+    status, response = handle(world.engine, "POST", path, {"amount": 250})
+    assert (status, response["amount"]) == (200, 250)
+    assert handle(world.engine, "POST", path, {"amount": 751})[0] == 400
+    assert handle(world.engine, "POST", path, {})[1]["amount"] == 750
+    assert handle(world.engine, "POST", path, {})[0] == 409
+
+
+def test_refund_uses_oldest_successful_payment_first(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [original] = world.ctx.store.payments_for_invoice(invoice["id"])
+    method = world.ctx.store.require_payment_method(original["method_id"])
+    del world.ctx.store.payments[original["id"]]
+
+    older_ref = world.gateway.charge(method, 400, "usd", "older")["gateway_ref"]
+    newer_ref = world.gateway.charge(method, 600, "usd", "newer")["gateway_ref"]
+    assert older_ref is not None and newer_ref is not None
+    older = {**original, "id": "pay_older", "amount": 400, "gateway_ref": older_ref, "created_at": 1}
+    newer = {**original, "id": "pay_newer", "amount": 600, "gateway_ref": newer_ref, "created_at": 2}
+    world.ctx.store.payments[newer["id"]] = newer
+    world.ctx.store.payments[older["id"]] = older
+
+    note = world.engine.refund(invoice["id"], amount=500)
+    assert note["amount"] == 500
+    assert world.gateway.refunds == [(older_ref, 400), (newer_ref, 100)]
+    assert older["status"] == "refunded"
+    assert newer["status"] == "partially_refunded"
+    assert newer["refunded_amount"] == 100
