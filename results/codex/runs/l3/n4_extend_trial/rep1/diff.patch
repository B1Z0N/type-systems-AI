+def test_extend_trial_delays_billing_and_emits_update(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    original_end = sub["trial_end"]
+
+    result = subscriptions.extend_trial(world.ctx, sub["id"], 3)
+
+    assert result is sub
+    assert sub["trial_end"] == original_end + 3 * SECONDS_PER_DAY
+    assert sub["current_period_end"] == sub["trial_end"]
+    [event] = events_of_type(world.ctx, "subscription.updated")
+    assert event["payload"]["subscription"]["current_period_end"] == sub["current_period_end"]
+    assert event["payload"]["previous_status"] == "trialing"
+
+    world.advance_days(14)
+    assert sub["status"] == "trialing"
+    assert world.engine.invoices_for(cus["id"]) == []
+    world.advance_days(3)
+    assert sub["status"] == "active"
+    [invoice] = world.engine.invoices_for(cus["id"])
+    assert invoice["total"] == 1000
+
+
+@pytest.mark.parametrize("days", [0, -1, 1.5, "2", True, None])
+def test_extend_trial_rejects_non_positive_integer_days(world, days):
+    cus = world.customer()
