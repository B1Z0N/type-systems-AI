+import pytest
+
+from billing import ledger, subscriptions
 from billing.clock import format_date
+from billing.errors import InvalidStateError, ValidationError
+from billing.events import events_of_type
+
+
+def test_extend_trial_delays_billing_and_emits_update(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    original_end = sub["trial_end"]
+
+    result = subscriptions.extend_trial(world.ctx, sub["id"], 3)
+
+    assert result is sub
+    assert sub["trial_end"] == original_end + 3 * 86_400
+    assert sub["current_period_end"] == original_end + 3 * 86_400
+    updates = events_of_type(world.ctx, "subscription.updated")
+    assert len(updates) == 1
+    assert updates[0]["payload"]["subscription"]["current_period_end"] == sub["current_period_end"]
+    world.advance_days(14)
+    assert sub["status"] == "trialing"
+    assert world.engine.invoices_for(cus["id"]) == []
+    world.advance_days(3)
+    assert sub["status"] == "active"
+    assert world.engine.invoices_for(cus["id"])[0]["total"] == 1000
+
+
+@pytest.mark.parametrize("days", [0, -1, 1.5, True, "2", None])
+def test_extend_trial_rejects_non_positive_whole_days(world, days):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    original_end = sub["trial_end"]
+
+    with pytest.raises(ValidationError):
+        subscriptions.extend_trial(world.ctx, sub["id"], days)
+
+    assert sub["trial_end"] == original_end
+    assert sub["current_period_end"] == original_end
+    assert events_of_type(world.ctx, "subscription.updated") == []
+
+
+def test_extend_trial_rejects_non_trialing_subscription(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    original_end = sub["current_period_end"]
+
+    with pytest.raises(InvalidStateError):
+        subscriptions.extend_trial(world.ctx, sub["id"], 3)
+
+    assert sub["current_period_end"] == original_end
+    assert events_of_type(world.ctx, "subscription.updated") == []
 
 
