+def test_metered_usage_is_billed_in_the_period_it_was_reported(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    start = to_millis(sub["current_period_start"])
+    end = to_millis(sub["current_period_end"])
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 2, start)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3, end - 1)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 7, end)
+
+    [first] = world.advance_days(31)
+    [line] = first["lines"]
+    assert line["kind"] == "usage"
+    assert line["quantity"] == 5
+    assert line["amount"] == 10
+
+    [second] = world.advance_days(28)
+    assert second["lines"][0]["quantity"] == 7
+    assert second["lines"][0]["amount"] == 14
