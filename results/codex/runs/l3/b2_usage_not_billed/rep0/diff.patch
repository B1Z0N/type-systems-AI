diff --git a/tests/test_lifecycle.py b/tests/test_lifecycle.py
index 0a2eb09..c885117 100644
--- a/tests/test_lifecycle.py
+++ b/tests/test_lifecycle.py
@@ -55,3 +55,27 @@ def test_credit_applied_on_finalize(world):
     assert inv["credit_applied"] == 700
     assert inv["amount_paid"] == 300
     assert ledger.balance(world.ctx, cus["id"]) == 0
+
+
+def test_metered_usage_is_billed_in_the_period_it_was_reported(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    period_start = sub["current_period_start"]
+    period_end = sub["current_period_end"]
+
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 2, period_end * 1000 - 1)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 7, period_end * 1000)
+
+    world.clock.set(period_end)
+    [first_renewal] = world.engine.run_cycle()
+    [first_usage] = first_renewal["lines"]
+    assert first_usage["kind"] == "usage"
+    assert first_usage["quantity"] == 5
+    assert first_usage["amount"] == 10
+    assert (first_usage["period_start"], first_usage["period_end"]) == (period_start, period_end)
+
+    world.clock.set(sub["current_period_end"])
+    [second_renewal] = world.engine.run_cycle()
+    assert second_renewal["lines"][0]["quantity"] == 7
+    assert second_renewal["total"] == 14
