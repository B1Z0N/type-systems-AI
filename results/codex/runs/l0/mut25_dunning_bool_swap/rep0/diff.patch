diff --git a/tests/test_lifecycle.py b/tests/test_lifecycle.py
index 0a2eb09..7eccde0 100644
--- a/tests/test_lifecycle.py
+++ b/tests/test_lifecycle.py
@@ -55,3 +55,29 @@ def test_credit_applied_on_finalize(world):
     assert inv["credit_applied"] == 700
     assert inv["amount_paid"] == 300
     assert ledger.balance(world.ctx, cus["id"]) == 0
+
+
+def test_declined_card_retries_only_on_dunning_schedule(world):
+    cus = world.customer(last4="0002")
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    finalized_at = inv["finalized_at"]
+
+    assert (inv["attempt_count"], sub["status"]) == (1, "past_due")
+    for day, attempts, next_day, status in [
+        (0, 1, 1, "past_due"),
+        (1, 2, 3, "past_due"),
+        (2, 2, 3, "past_due"),
+        (3, 3, 7, "past_due"),
+        (4, 3, 7, "past_due"),
+        (5, 3, 7, "past_due"),
+        (6, 3, 7, "past_due"),
+        (7, 4, None, "unpaid"),
+        (8, 4, None, "unpaid"),
+    ]:
+        world.clock.set(finalized_at + day * 86_400)
+        world.engine.run_cycle()
+        assert inv["attempt_count"] == attempts
+        assert len(world.gateway.charges) == attempts
+        assert inv["next_attempt_at"] == (finalized_at + next_day * 86_400 if next_day else None)
+        assert sub["status"] == status
