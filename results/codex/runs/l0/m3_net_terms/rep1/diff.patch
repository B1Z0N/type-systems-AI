diff --git a/tests/test_customer_terms.py b/tests/test_customer_terms.py
new file mode 100644
index 0000000..055bd24
--- /dev/null
+++ b/tests/test_customer_terms.py
@@ -0,0 +1,48 @@
+import pytest
+
+from billing import customers, invoices
+from billing.api import handle
+from billing.errors import ValidationError
+
+DAY = 86_400
+
+
+def test_customer_terms_are_read_when_invoice_is_finalized(world):
+    customer = customers.create_customer(world.ctx, "terms@example.com", "Terms")
+    assert customer["net_terms_days"] == 7
+
+    first = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+    invoices.finalize(world.ctx, first["id"])
+    assert first["due_at"] == first["finalized_at"] + 7 * DAY
+
+    draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+    customers.update_customer(world.ctx, customer["id"], net_terms_days=0)
+    invoices.finalize(world.ctx, draft["id"])
+    assert draft["due_at"] == draft["finalized_at"]
+    assert first["due_at"] == first["finalized_at"] + 7 * DAY
+
+
+def test_customer_terms_validation_and_api(world):
+    with pytest.raises(ValidationError):
+        customers.create_customer(world.ctx, "bad@example.com", "Bad", net_terms_days=-1)
+
+    customer = customers.create_customer(world.ctx, "valid@example.com", "Valid", net_terms_days=14)
+    assert customer["net_terms_days"] == 14
+    with pytest.raises(ValidationError):
+        customers.update_customer(world.ctx, customer["id"], net_terms_days=-1)
+    assert customer["net_terms_days"] == 14
+
+    status, created = handle(
+        world.engine, "POST", "/customers",
+        {"email": "api@example.com", "name": "API", "net_terms_days": 21},
+    )
+    assert status == 201
+    assert created["net_terms_days"] == 21
+    assert world.ctx.store.require_customer(created["id"])["net_terms_days"] == 21
+
+    for invalid in (-1, True, "7"):
+        status, _ = handle(
+            world.engine, "POST", "/customers",
+            {"email": "invalid@example.com", "name": "Invalid", "net_terms_days": invalid},
+        )
+        assert status == 400
