diff --git a/tests/test_customer_net_terms.py b/tests/test_customer_net_terms.py
new file mode 100644
index 0000000..45d63c2
--- /dev/null
+++ b/tests/test_customer_net_terms.py
@@ -0,0 +1,57 @@
+import pytest
+
+from billing import customers, invoices
+from billing.api import handle
+from billing.errors import ValidationError
+
+
+def test_customer_default_and_custom_terms_set_invoice_due_date(world):
+    default = customers.create_customer(world.ctx, "default@example.com", "Default")
+    custom = customers.create_customer(world.ctx, "custom@example.com", "Custom", net_terms_days=30)
+
+    assert default["net_terms_days"] == 7
+    assert custom["net_terms_days"] == 30
+
+    for customer, days in ((default, 7), (custom, 30)):
+        draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+        finalized = invoices.finalize(world.ctx, draft["id"])
+        assert finalized["due_at"] == finalized["finalized_at"] + days * 86_400
+
+
+def test_invoice_uses_terms_current_at_finalization(world):
+    customer = customers.create_customer(world.ctx, "change@example.com", "Change", net_terms_days=14)
+    draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+    customers.update_customer(world.ctx, customer["id"], net_terms_days=0)
+    world.clock.advance_days(2)
+
+    finalized = invoices.finalize(world.ctx, draft["id"])
+    assert finalized["due_at"] == finalized["finalized_at"]
+
+
+@pytest.mark.parametrize("invalid", [-1, 1.5, True, "7", None])
+def test_create_rejects_invalid_terms(world, invalid):
+    with pytest.raises(ValidationError):
+        customers.create_customer(world.ctx, "invalid@example.com", "Invalid", net_terms_days=invalid)
+
+
+@pytest.mark.parametrize("invalid", [-1, 1.5, True, "7", None])
+def test_update_rejects_invalid_terms_without_changing_customer(world, invalid):
+    customer = customers.create_customer(world.ctx, "keep@example.com", "Keep")
+    with pytest.raises(ValidationError):
+        customers.update_customer(world.ctx, customer["id"], net_terms_days=invalid)
+    assert customer["net_terms_days"] == 7
+
+
+def test_api_accepts_terms_and_reports_negative_as_400(world):
+    status, created = handle(
+        world.engine, "POST", "/customers", {"email": "api@example.com", "name": "API", "net_terms_days": 21}
+    )
+    assert status == 201
+    assert created["net_terms_days"] == 21
+    assert world.ctx.store.require_customer(created["id"])["net_terms_days"] == 21
+
+    status, error = handle(
+        world.engine, "POST", "/customers", {"email": "bad@example.com", "name": "Bad", "net_terms_days": -1}
+    )
+    assert status == 400
+    assert "net_terms_days" in error["error"]
