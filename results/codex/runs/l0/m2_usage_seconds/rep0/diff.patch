diff --git a/tests/test_usage.py b/tests/test_usage.py
new file mode 100644
index 0000000..2e48132
--- /dev/null
+++ b/tests/test_usage.py
@@ -0,0 +1,60 @@
+from billing import catalog, usage
+from billing.api import handle
+
+
+def test_usage_timestamps_are_stored_in_seconds_and_api_echoes_milliseconds(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    reported_at = world.clock.now() * 1000 + 123
+
+    record = usage.report_usage(world.ctx, subscription["id"], world.api_calls["id"], 2, reported_at)
+    assert record["timestamp"] == world.clock.now()
+    assert record["timestamp_ms_remainder"] == 123
+    assert world.ctx.store.usage_records[record["id"]] is record
+
+    engine_record = world.engine.report_usage(subscription["id"], world.api_calls["id"], 3)
+    assert engine_record["timestamp"] == world.clock.now()
+    assert engine_record["timestamp_ms_remainder"] == 0
+
+    body = {
+        "subscription": subscription["id"],
+        "price": world.api_calls["id"],
+        "quantity": 4,
+        "timestamp": reported_at + 1,
+        "idempotency_key": "usage-1",
+    }
+    status, response = handle(world.engine, "POST", "/usage", body)
+    assert status == 201
+    assert response["timestamp"] == body["timestamp"]
+    assert world.ctx.store.usage_records[response["id"]]["timestamp"] == world.clock.now()
+    assert handle(world.engine, "POST", "/usage", body) == (status, response)
+
+
+def test_usage_billing_preserves_period_edges_and_millisecond_order(world):
+    last_price = catalog.create_price(
+        world.ctx, world.api["id"], "usd", "metered", unit_amount=3, usage_aggregation="last"
+    )
+    customer = world.customer()
+    subscription = world.engine.subscribe(
+        customer["id"], [(world.api_calls["id"], 0), (last_price["id"], 0)]
+    )
+    start = subscription["current_period_start"]
+    end = subscription["current_period_end"]
+
+    for timestamp, quantity in (
+        (start * 1000 - 1, 100),
+        (start * 1000, 5),
+        (end * 1000 - 1, 7),
+        (end * 1000, 100),
+    ):
+        world.engine.report_usage(subscription["id"], world.api_calls["id"], quantity, timestamp)
+
+    # Report the later event first so record IDs alone cannot determine "last".
+    world.engine.report_usage(subscription["id"], last_price["id"], 9, end * 1000 - 1)
+    world.engine.report_usage(subscription["id"], last_price["id"], 4, end * 1000 - 999)
+
+    world.clock.set(end)
+    invoices = world.engine.run_cycle()
+    usage_lines = {line["price_id"]: line for line in invoices[0]["lines"] if line["kind"] == "usage"}
+    assert usage_lines[world.api_calls["id"]]["quantity"] == 12
+    assert usage_lines[last_price["id"]]["quantity"] == 9
