diff --git a/tests/test_usage_timestamps.py b/tests/test_usage_timestamps.py
new file mode 100644
index 0000000..4808460
--- /dev/null
+++ b/tests/test_usage_timestamps.py
@@ -0,0 +1,60 @@
+from billing import catalog, usage
+from billing.api import handle
+
+
+def test_usage_stores_seconds_and_preserves_period_boundaries(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    start = subscription["current_period_start"]
+    end = subscription["current_period_end"]
+
+    for timestamp, quantity in (
+        (start * 1000 - 1, 1),
+        (start * 1000 + 1, 2),
+        (end * 1000 - 1, 3),
+        (end * 1000, 4),
+    ):
+        record = usage.report_usage(world.ctx, subscription["id"], world.api_calls["id"], quantity, timestamp)
+        assert record["timestamp"] == timestamp / 1000
+        assert world.ctx.store.usage_records[record["id"]]["timestamp"] == timestamp / 1000
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], world.api_calls["id"], start, end) == 5
+    world.clock.set(end)
+    [invoice] = world.engine.run_cycle()
+    assert [line["amount"] for line in invoice["lines"] if line["kind"] == "usage"] == [10]
+
+
+def test_last_usage_keeps_millisecond_order(world):
+    last_price = catalog.create_price(
+        world.ctx, world.api["id"], "usd", "metered", unit_amount=2, usage_aggregation="last"
+    )
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(last_price["id"], 0)])
+    timestamp = world.clock.now() * 1000
+
+    world.engine.report_usage(subscription["id"], last_price["id"], 9, timestamp + 900)
+    world.engine.report_usage(subscription["id"], last_price["id"], 2, timestamp + 100)
+
+    assert usage.aggregate_usage(
+        world.ctx, subscription["id"], last_price["id"],
+        subscription["current_period_start"], subscription["current_period_end"],
+    ) == 9
+
+
+def test_api_returns_milliseconds_for_explicit_and_default_timestamps(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    body = {"subscription": subscription["id"], "price": world.api_calls["id"], "quantity": 1}
+    timestamp = world.clock.now() * 1000 + 123
+
+    status, explicit = handle(world.engine, "POST", "/usage", {**body, "timestamp": timestamp, "idempotency_key": "usage-1"})
+    assert status == 201
+    assert explicit["timestamp"] == timestamp
+    assert world.ctx.store.usage_records[explicit["id"]]["timestamp"] == timestamp / 1000
+
+    _, repeated = handle(world.engine, "POST", "/usage", {**body, "timestamp": timestamp, "idempotency_key": "usage-1"})
+    assert repeated == explicit
+
+    _, default = handle(world.engine, "POST", "/usage", body)
+    assert default["timestamp"] == world.clock.now() * 1000
+    assert world.ctx.store.usage_records[default["id"]]["timestamp"] == world.clock.now()
