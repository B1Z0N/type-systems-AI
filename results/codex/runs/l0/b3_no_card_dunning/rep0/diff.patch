+def test_missing_payment_method_enters_dunning_and_retries(world):
+    cus = world.customer(card=False)
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    assert inv["status"] == "open"
+    assert inv["attempt_count"] == 1
+    assert inv["next_attempt_at"] == inv["finalized_at"] + SECONDS_PER_DAY
+    assert sub["status"] == "past_due"
+    assert world.gateway.charges == []
+
+    previous_day = 0
+    for day, attempt, next_day in [(1, 2, 3), (3, 3, 7), (7, 4, None)]:
+        world.advance_days(day - previous_day)
+        assert inv["attempt_count"] == attempt
+        assert inv["next_attempt_at"] == (
+            inv["finalized_at"] + next_day * SECONDS_PER_DAY if next_day is not None else None
+        )
+        previous_day = day
+
+    assert sub["status"] == "unpaid"
+    assert inv["status"] == "open"
+    assert world.gateway.charges == []
+    failures = events_of_type(world.ctx, "invoice.payment_failed")
+    assert [event["payload"]["failure_code"] for event in failures] == ["no_payment_method"] * 4
+    assert [event["payload"]["attempt"] for event in failures] == [1, 2, 3, 4]
