+
+def test_missing_payment_method_enters_dunning_and_recovers_on_retry(world):
+    cus = world.customer(card=False)
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    assert inv["status"] == "open"
+    assert inv["attempt_count"] == 1
+    assert inv["next_attempt_at"] == inv["finalized_at"] + DAY
+    assert sub["status"] == "past_due"
+    assert world.gateway.charges == []
+    [failure] = events_of_type(world.ctx, "invoice.payment_failed")
+    assert failure["payload"]["failure_code"] == "no_payment_method"
+    assert failure["payload"]["attempt"] == 1
+
+    customers.attach_payment_method(world.ctx, cus["id"], "card", "4242", 12, 2030)
+    world.advance_days(1)
+    assert inv["status"] == "paid"
+    assert inv["attempt_count"] == 1
+    assert inv["next_attempt_at"] is None
+    assert sub["status"] == "active"
+    assert len(world.gateway.charges) == 1
+
+
+def test_missing_payment_method_retries_until_final_dunning_action(world):
+    cus = world.customer(card=False)
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    for day, attempt, next_day in [(1, 2, 3), (3, 3, 7), (7, 4, None)]:
+        world.clock.advance(inv["finalized_at"] + day * DAY - world.clock.now())
+        world.engine.run_cycle()
+        assert inv["attempt_count"] == attempt
+        assert inv["next_attempt_at"] == (inv["finalized_at"] + next_day * DAY if next_day else None)
+
+    assert inv["status"] == "open"
+    assert sub["status"] == "unpaid"
+    assert world.gateway.charges == []
+    assert [event["payload"]["failure_code"] for event in events_of_type(world.ctx, "invoice.payment_failed")] == [
+        "no_payment_method"
+    ] * 4
