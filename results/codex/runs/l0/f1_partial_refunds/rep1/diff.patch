diff --git a/tests/test_refunds.py b/tests/test_refunds.py
new file mode 100644
index 0000000..693522f
--- /dev/null
+++ b/tests/test_refunds.py
@@ -0,0 +1,89 @@
+import pytest
+
+from billing import api, ledger, refunds
+from billing.errors import InvalidStateError, ValidationError
+
+
+def paid_invoice(world, *, credit=0):
+    customer = world.customer()
+    if credit:
+        ledger.grant_credit(world.ctx, customer["id"], credit)
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    return customer, world.engine.invoices_for(customer["id"])[0]
+
+
+def test_partial_refunds_then_refund_remainder_and_credit(world):
+    customer, invoice = paid_invoice(world, credit=300)
+    payment = world.ctx.store.payments_for_invoice(invoice["id"])[0]
+
+    first = world.engine.refund(invoice["id"], amount=200)
+    second = refunds.refund_invoice(world.ctx, invoice["id"], amount=100)
+    assert [first["amount"], second["amount"]] == [200, 100]
+    assert all(note["refunded"] for note in (first, second))
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 300
+    assert ledger.balance(world.ctx, customer["id"]) == 0
+
+    last = world.engine.refund(invoice["id"])
+    assert last["amount"] == 700  # 400 paid money plus 300 applied credit
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 700
+    assert world.gateway.refunds == [(payment["gateway_ref"], 200), (payment["gateway_ref"], 100), (payment["gateway_ref"], 400)]
+    assert ledger.balance(world.ctx, customer["id"]) == 300
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+    assert ledger.balance(world.ctx, customer["id"]) == 300
+
+
+def test_amount_validation_has_no_refund_side_effects(world):
+    _, invoice = paid_invoice(world)
+    for amount in (0, -1, 1001, True, 1.5):
+        with pytest.raises(ValidationError):
+            world.engine.refund(invoice["id"], amount=amount)
+    assert world.gateway.refunds == []
+    assert world.ctx.store.credit_notes_for(invoice["id"]) == []
+    world.engine.refund(invoice["id"], amount=1000)
+    with pytest.raises(ValidationError):
+        world.engine.refund(invoice["id"], amount=1)
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_amount_free_refund_restores_credit_after_all_cash_was_refunded(world):
+    customer, invoice = paid_invoice(world, credit=800)
+    first = world.engine.refund(invoice["id"], amount=200)
+    last = world.engine.refund(invoice["id"])
+    assert (first["amount"], last["amount"]) == (200, 800)
+    assert ledger.balance(world.ctx, customer["id"]) == 800
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refunds_use_oldest_payment_first(world):
+    customer, invoice = paid_invoice(world)
+    first = world.ctx.store.payments_for_invoice(invoice["id"])[0]
+    first["amount"] = 400
+    world.gateway._captured[first["gateway_ref"]] = 400
+    method = world.ctx.store.payment_methods_for(customer["id"])[0]
+    second_charge = world.gateway.charge(method, 600, "usd", "second-payment")
+    second = dict(first, id=world.ctx.ids.payment(), amount=600, gateway_ref=second_charge["gateway_ref"], created_at=first["created_at"] + 1)
+    world.ctx.store.payments[second["id"]] = second
+
+    note = world.engine.refund(invoice["id"], amount=650)
+    assert note["amount"] == 650
+    assert world.gateway.refunds == [(first["gateway_ref"], 400), (second["gateway_ref"], 250)]
+    assert first["status"] == "refunded"
+    assert second["status"] == "partially_refunded"
+    assert second["refunded_amount"] == 250
+
+
+def test_refund_api_accepts_optional_amount(world):
+    _, invoice = paid_invoice(world)
+    path = f"/invoices/{invoice['id']}/refund"
+    status, body = api.handle(world.engine, "POST", path, {"amount": 250})
+    assert (status, body["amount"]) == (200, 250)
+    assert api.handle(world.engine, "POST", path, {"amount": "250"})[0] == 400
+    assert api.handle(world.engine, "POST", path, {"amount": 751})[0] == 400
+    status, body = api.handle(world.engine, "POST", path)
+    assert (status, body["amount"]) == (200, 750)
+    assert api.handle(world.engine, "POST", path)[0] == 409
