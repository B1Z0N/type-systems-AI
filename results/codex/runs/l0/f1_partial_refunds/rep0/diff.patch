diff --git a/tests/test_credit_notes.py b/tests/test_credit_notes.py
index 26befa7..eabd89f 100644
--- a/tests/test_credit_notes.py
+++ b/tests/test_credit_notes.py
@@ -1,6 +1,8 @@
 import pytest
 
 from billing import ledger, refunds
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
 
 
 def test_credit_note_limits(world):
@@ -11,3 +13,81 @@ def test_credit_note_limits(world):
     assert ledger.balance(world.ctx, cus["id"]) == 400
     with pytest.raises(Exception):
         refunds.credit_invoice(world.ctx, inv["id"], 700, "too much")
+
+
+def test_partial_refunds_and_remaining_full_refund(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [payment] = world.ctx.store.payments_for_invoice(invoice["id"])
+
+    first = world.engine.refund(invoice["id"], amount=300)
+    assert first["amount"] == 300 and first["refunded"] is True
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 300
+
+    second = refunds.refund_invoice(world.ctx, invoice["id"], amount=200)
+    assert second["amount"] == 200
+    final = world.engine.refund(invoice["id"])
+    assert final["amount"] == 500
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 1000
+    assert [amount for _, amount in world.gateway.refunds] == [300, 200, 500]
+    assert [note["amount"] for note in world.ctx.store.credit_notes_for(invoice["id"])] == [300, 200, 500]
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_amount_validation_does_not_change_payment(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    for amount in (0, -1, 1001, True, 1.5):
+        with pytest.raises(ValidationError):
+            world.engine.refund(invoice["id"], amount=amount)
+    assert world.gateway.refunds == []
+    assert world.ctx.store.credit_notes_for(invoice["id"]) == []
+
+
+def test_refund_oldest_payment_first(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [first_payment] = world.ctx.store.payments_for_invoice(invoice["id"])
+    first_payment["amount"] = 400
+    world.gateway._captured[first_payment["gateway_ref"]] = 400
+    method = world.ctx.store.require_payment_method(first_payment["method_id"])
+    charge = world.gateway.charge(method, 600, "usd", "second-payment")
+    second_payment = dict(first_payment, id=world.ctx.ids.payment(), amount=600, gateway_ref=charge["gateway_ref"])
+    second_payment["created_at"] += 1
+    world.ctx.store.payments[second_payment["id"]] = second_payment
+
+    note = world.engine.refund(invoice["id"], amount=550)
+    assert note["amount"] == 550
+    assert world.gateway.refunds == [(first_payment["gateway_ref"], 400), (second_payment["gateway_ref"], 150)]
+    assert first_payment["status"] == "refunded"
+    assert second_payment["status"] == "partially_refunded"
+    assert world.engine.refund(invoice["id"])["amount"] == 450
+
+
+def test_full_refund_after_partial_restores_applied_credit_once(world):
+    customer = world.customer()
+    ledger.grant_credit(world.ctx, customer["id"], 700)
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    assert world.engine.refund(invoice["id"], amount=100)["amount"] == 100
+    assert ledger.balance(world.ctx, customer["id"]) == 0
+    assert world.engine.refund(invoice["id"])["amount"] == 900
+    assert ledger.balance(world.ctx, customer["id"]) == 700
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_api_accepts_amount(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    path = f"/invoices/{invoice['id']}/refund"
+    assert handle(world.engine, "POST", path, {"amount": "100"})[0] == 400
+    assert handle(world.engine, "POST", path, {"amount": 250})[1]["amount"] == 250
+    assert handle(world.engine, "POST", path, {})[1]["amount"] == 750
