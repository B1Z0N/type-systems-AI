+def test_metered_usage_is_billed_in_the_period_it_was_reported(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    first_period_end = sub["current_period_end"]
+
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3)
+    world.clock.set(first_period_end)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 4)
+
+    [first_renewal] = world.engine.run_cycle()
+    [first_line] = first_renewal["lines"]
+    assert first_line["quantity"] == 3
+    assert first_renewal["total"] == 6
+
+    world.clock.set(sub["current_period_end"])
+    [second_renewal] = world.engine.run_cycle()
+    [second_line] = second_renewal["lines"]
+    assert second_line["quantity"] == 4
+    assert second_renewal["total"] == 8
+
+
