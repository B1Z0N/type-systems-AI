diff --git a/tests/test_usage_timestamp_seconds.py b/tests/test_usage_timestamp_seconds.py
new file mode 100644
index 0000000..1eea35f
--- /dev/null
+++ b/tests/test_usage_timestamp_seconds.py
@@ -0,0 +1,61 @@
+from billing import usage
+from billing.api import handle
+from billing.clock import to_millis
+
+
+def test_usage_timestamps_are_seconds_in_store_and_milliseconds_for_callers(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    base_ms = to_millis(world.clock.now())
+
+    direct = usage.report_usage(world.ctx, subscription["id"], world.api_calls["id"], 2, base_ms + 123)
+    engine = world.engine.report_usage(
+        subscription["id"], world.api_calls["id"], 3, base_ms + 456, idempotency_key="usage-1"
+    )
+    status, api = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {
+            "subscription": subscription["id"],
+            "price": world.api_calls["id"],
+            "quantity": 4,
+            "timestamp": base_ms + 789,
+        },
+    )
+
+    assert status == 201
+    assert [direct["timestamp"], engine["timestamp"], api["timestamp"]] == [
+        base_ms + 123, base_ms + 456, base_ms + 789
+    ]
+    assert [world.ctx.store.usage_records[record["id"]]["timestamp"] for record in (direct, engine, api)] == [
+        world.clock.now() + 0.123, world.clock.now() + 0.456, world.clock.now() + 0.789
+    ]
+    repeated = world.engine.report_usage(
+        subscription["id"], world.api_calls["id"], 99, base_ms + 999, idempotency_key="usage-1"
+    )
+    assert repeated == engine
+    defaulted = world.engine.report_usage(subscription["id"], world.api_calls["id"], 1)
+    assert defaulted["timestamp"] == base_ms
+    assert world.ctx.store.usage_records[defaulted["id"]]["timestamp"] == world.clock.now()
+    assert len(world.ctx.store.usage_records) == 4
+
+
+def test_usage_period_boundaries_and_invoice_quantities_are_unchanged(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    start = subscription["current_period_start"]
+    end = subscription["current_period_end"]
+    price_id = world.api_calls["id"]
+
+    world.engine.report_usage(subscription["id"], price_id, 2, to_millis(start) - 1)
+    world.engine.report_usage(subscription["id"], price_id, 3, to_millis(start))
+    world.engine.report_usage(subscription["id"], price_id, 5, to_millis(end) - 1)
+    world.engine.report_usage(subscription["id"], price_id, 7, to_millis(end))
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], price_id, start, end) == 8
+    world.clock.set(end)
+    [invoice] = world.engine.run_cycle()
+    [line] = [line for line in invoice["lines"] if line["kind"] == "usage"]
+    assert line["quantity"] == 8
+    assert line["amount"] == 16
