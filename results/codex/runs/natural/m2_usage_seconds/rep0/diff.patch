diff --git a/tests/test_usage_seconds.py b/tests/test_usage_seconds.py
new file mode 100644
index 0000000..b61d01a
--- /dev/null
+++ b/tests/test_usage_seconds.py
@@ -0,0 +1,56 @@
+from billing import catalog, usage
+from billing.api import handle
+
+
+def test_usage_stores_seconds_and_api_round_trips_milliseconds(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    timestamp_ms = subscription["current_period_start"] * 1000 + 123
+
+    record = usage.report_usage(world.ctx, subscription["id"], world.api_calls["id"], 3, timestamp_ms)
+    assert record["timestamp"] == subscription["current_period_start"]
+    assert world.ctx.store.usage_records[record["id"]]["timestamp"] == subscription["current_period_start"]
+    default_record = world.engine.report_usage(subscription["id"], world.api_calls["id"], 1)
+    assert default_record["timestamp"] == world.clock.now()
+
+    status, response = handle(world.engine, "POST", "/usage", {
+        "subscription": subscription["id"],
+        "price": world.api_calls["id"],
+        "quantity": 4,
+        "timestamp": timestamp_ms + 1,
+        "idempotency_key": "api-usage",
+    })
+    assert status == 201
+    assert response["timestamp"] == timestamp_ms + 1
+    assert world.ctx.store.usage_records[response["id"]]["timestamp"] == subscription["current_period_start"]
+
+    status, replay = handle(world.engine, "POST", "/usage", {
+        "subscription": subscription["id"],
+        "price": world.api_calls["id"],
+        "quantity": 99,
+        "timestamp": timestamp_ms + 999,
+        "idempotency_key": "api-usage",
+    })
+    assert status == 201
+    assert replay == response
+
+
+def test_usage_period_boundaries_and_last_order_are_unchanged(world):
+    customer = world.customer()
+    price = catalog.create_price(world.ctx, world.api["id"], "usd", "metered", unit_amount=2,
+                                 usage_aggregation="last")
+    subscription = world.engine.subscribe(customer["id"], [(price["id"], 0)])
+    start = subscription["current_period_start"]
+    end = subscription["current_period_end"]
+
+    world.engine.report_usage(subscription["id"], price["id"], 99, start * 1000 - 1)
+    world.engine.report_usage(subscription["id"], price["id"], 8, start * 1000 + 900)
+    world.engine.report_usage(subscription["id"], price["id"], 3, start * 1000 + 100)
+    world.engine.report_usage(subscription["id"], price["id"], 77, end * 1000)
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], price["id"], start, end) == 8
+    world.clock.set(end)
+    [invoice] = world.engine.run_cycle()
+    [line] = invoice["lines"]
+    assert line["quantity"] == 8
+    assert line["amount"] == 16
