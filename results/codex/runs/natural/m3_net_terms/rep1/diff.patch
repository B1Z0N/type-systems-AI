@@ -1,5 +1,9 @@
-from billing import ledger
+import pytest
+
+from billing import customers, invoices, ledger
 from billing.clock import format_date
+from billing.errors import ValidationError
+from billing.models import SECONDS_PER_DAY
 
 
 def test_subscribe_invoices_and_charges_first_period(world):
@@ -55,3 +59,28 @@ def test_credit_applied_on_finalize(world):
     assert inv["credit_applied"] == 700
     assert inv["amount_paid"] == 300
     assert ledger.balance(world.ctx, cus["id"]) == 0
+
+
+def test_invoice_uses_customer_terms_at_finalization(world):
+    cus = customers.create_customer(world.ctx, "terms@example.com", "Terms", net_terms_days=30)
+    first = invoices.create_one_off(world.ctx, cus["id"], [("Service", 100, 1)])
+    customers.update_customer(world.ctx, cus["id"], net_terms_days=0)
+    invoices.finalize(world.ctx, first["id"])
+    assert first["due_at"] == first["finalized_at"]
+
+    customers.update_customer(world.ctx, cus["id"], net_terms_days=14)
+    second = invoices.create_one_off(world.ctx, cus["id"], [("Service", 100, 1)])
+    invoices.finalize(world.ctx, second["id"])
+    assert second["due_at"] == second["finalized_at"] + 14 * SECONDS_PER_DAY
+    assert first["due_at"] == first["finalized_at"]
+
+
+def test_customer_terms_default_and_validation(world):
+    cus = customers.create_customer(world.ctx, "default@example.com", "Default")
+    assert cus["net_terms_days"] == 7
+    for invalid in (-1, True, 1.5, "10"):
+        with pytest.raises(ValidationError):
+            customers.create_customer(world.ctx, "bad@example.com", "Bad", net_terms_days=invalid)
+        with pytest.raises(ValidationError):
+            customers.update_customer(world.ctx, cus["id"], net_terms_days=invalid)
+    assert cus["net_terms_days"] == 7
