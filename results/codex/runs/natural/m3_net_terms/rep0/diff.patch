diff --git a/tests/test_net_terms.py b/tests/test_net_terms.py
new file mode 100644
index 0000000..f2b2093
--- /dev/null
+++ b/tests/test_net_terms.py
@@ -0,0 +1,41 @@
+import pytest
+
+from billing import customers, invoices
+from billing.api import handle
+from billing.errors import ValidationError
+from billing.models import SECONDS_PER_DAY
+
+
+def test_customer_terms_apply_at_finalization(world):
+    customer = customers.create_customer(world.ctx, "terms@example.com", "Terms", net_terms_days=14)
+    first = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+    assert invoices.finalize(world.ctx, first["id"])["due_at"] == world.clock.now() + 14 * SECONDS_PER_DAY
+
+    draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+    customers.update_customer(world.ctx, customer["id"], net_terms_days=0)
+    assert invoices.finalize(world.ctx, draft["id"])["due_at"] == world.clock.now()
+    assert first["due_at"] == first["finalized_at"] + 14 * SECONDS_PER_DAY
+
+
+def test_default_terms_and_invalid_values(world):
+    customer = customers.create_customer(world.ctx, "default@example.com", "Default")
+    assert customer["net_terms_days"] == 7
+    draft = invoices.create_one_off(world.ctx, customer["id"], [("Service", 100, 1)])
+    assert invoices.finalize(world.ctx, draft["id"])["due_at"] == world.clock.now() + 7 * SECONDS_PER_DAY
+
+    for value in (-1, True, None, 1.5, "3"):
+        with pytest.raises(ValidationError):
+            customers.create_customer(world.ctx, "bad@example.com", "Bad", net_terms_days=value)
+        with pytest.raises(ValidationError):
+            customers.update_customer(world.ctx, customer["id"], net_terms_days=value)
+        assert customer["net_terms_days"] == 7
+
+
+def test_api_customer_terms(world):
+    body = {"email": "api@example.com", "name": "API"}
+    status, customer = handle(world.engine, "POST", "/customers", {**body, "net_terms_days": 30})
+    assert status == 201
+    assert customer["net_terms_days"] == 30
+
+    for value in (-1, True, None, "3"):
+        assert handle(world.engine, "POST", "/customers", {**body, "net_terms_days": value})[0] == 400
