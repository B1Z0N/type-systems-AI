diff --git a/tests/test_partial_refunds.py b/tests/test_partial_refunds.py
new file mode 100644
index 0000000..40fab7c
--- /dev/null
+++ b/tests/test_partial_refunds.py
@@ -0,0 +1,88 @@
+import pytest
+
+from billing import ledger, refunds
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
+
+
+def test_partial_refunds_and_remaining_full_refund(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [payment] = world.ctx.store.payments_for_invoice(invoice["id"])
+
+    first = world.engine.refund(invoice["id"], amount=250)
+    assert first["amount"] == 250 and first["refunded"] is True
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 250
+
+    second = refunds.refund_invoice(world.ctx, invoice["id"], amount=300)
+    assert second["amount"] == 300
+    assert payment["status"] == "partially_refunded"
+
+    last = world.engine.refund(invoice["id"])
+    assert last["amount"] == 450
+    assert payment["status"] == "refunded"
+    assert [amount for _, amount in world.gateway.refunds] == [250, 300, 450]
+    assert len(world.ctx.store.credit_notes_for(invoice["id"])) == 3
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_amount_validation_does_not_change_payment(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+
+    for amount in (0, -1, 1001, True):
+        with pytest.raises(ValidationError):
+            world.engine.refund(invoice["id"], amount=amount)
+    assert world.gateway.refunds == []
+
+
+def test_applied_credit_is_restored_only_by_refund_without_amount(world):
+    customer = world.customer()
+    ledger.grant_credit(world.ctx, customer["id"], 700)
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+
+    assert world.engine.refund(invoice["id"], amount=300)["amount"] == 300
+    assert ledger.balance(world.ctx, customer["id"]) == 0
+    assert world.engine.refund(invoice["id"])["amount"] == 700
+    assert ledger.balance(world.ctx, customer["id"]) == 700
+    assert world.gateway.refunds[0][1] == 300
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_api_accepts_optional_amount(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    path = f"/invoices/{invoice['id']}/refund"
+
+    assert handle(world.engine, "POST", path, {"amount": 150})[1]["amount"] == 150
+    assert handle(world.engine, "POST", path, {"amount": "150"})[0] == 400
+    assert handle(world.engine, "POST", path, {})[1]["amount"] == 850
+
+
+def test_refund_uses_oldest_payment_first(world):
+    customer = world.customer()
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(customer["id"])
+    [first] = world.ctx.store.payments_for_invoice(invoice["id"])
+    first["amount"] = 400
+    world.gateway._captured_by_ref[first["gateway_ref"]] = 400
+
+    method = world.ctx.store.payment_methods[first["method_id"]]
+    charge = world.gateway.charge(method, 600, "usd", "second-payment")
+    second = dict(first, id=world.ctx.ids.payment(), amount=600, gateway_ref=charge["gateway_ref"])
+    second["created_at"] += 1
+    world.ctx.store.payments[second["id"]] = second
+
+    note = world.engine.refund(invoice["id"], amount=500)
+    assert note["amount"] == 500
+    assert first["status"] == "refunded"
+    assert second["status"] == "partially_refunded"
+    assert second["refunded_amount"] == 100
+    assert world.gateway.refunds == [(first["gateway_ref"], 400), (second["gateway_ref"], 100)]
