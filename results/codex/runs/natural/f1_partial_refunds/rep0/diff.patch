diff --git a/tests/test_partial_refunds.py b/tests/test_partial_refunds.py
new file mode 100644
index 0000000..7ae8b9d
--- /dev/null
+++ b/tests/test_partial_refunds.py
@@ -0,0 +1,81 @@
+import pytest
+
+from billing import api, ledger, refunds
+from billing.errors import InvalidStateError, ValidationError
+
+
+def paid_invoice(world, credit=0):
+    customer = world.customer()
+    if credit:
+        ledger.grant_credit(world.ctx, customer["id"], credit)
+    world.engine.subscribe(customer["id"], [(world.monthly["id"], 1)])
+    return customer, world.engine.invoices_for(customer["id"])[0]
+
+
+def test_partial_refunds_then_full_refund_only_remainder(world):
+    _, invoice = paid_invoice(world)
+    payment = world.ctx.store.payments_for_invoice(invoice["id"])[0]
+
+    first = refunds.refund_invoice(world.ctx, invoice["id"], amount=250)
+    second = world.engine.refund(invoice["id"], amount=300)
+    last = world.engine.refund(invoice["id"])
+
+    assert [note["amount"] for note in (first, second, last)] == [250, 300, 450]
+    assert all(note["refunded"] for note in (first, second, last))
+    assert [amount for _, amount in world.gateway.refunds] == [250, 300, 450]
+    assert payment["refunded_amount"] == 1000
+    assert payment["status"] == "refunded"
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_partial_refund_status_and_validation(world):
+    _, invoice = paid_invoice(world)
+    payment = world.ctx.store.payments_for_invoice(invoice["id"])[0]
+    world.engine.refund(invoice["id"], amount=400)
+    assert payment["status"] == "partially_refunded"
+    for amount in (0, -1, 601, True, 1.5):
+        with pytest.raises(ValidationError):
+            world.engine.refund(invoice["id"], amount=amount)
+    assert len(world.gateway.refunds) == 1
+
+
+def test_full_refund_returns_applied_credit_once(world):
+    customer, invoice = paid_invoice(world, credit=700)
+    first = world.engine.refund(invoice["id"], amount=100)
+    last = world.engine.refund(invoice["id"])
+    assert [first["amount"], last["amount"]] == [100, 900]
+    assert [amount for _, amount in world.gateway.refunds] == [100, 200]
+    assert ledger.balance(world.ctx, customer["id"]) == 700
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_api_accepts_optional_refund_amount(world):
+    _, invoice = paid_invoice(world)
+    path = f"/invoices/{invoice['id']}/refund"
+    assert api.handle(world.engine, "POST", path, {"amount": 125})[1]["amount"] == 125
+    assert api.handle(world.engine, "POST", path, {"amount": "125"})[0] == 400
+    assert api.handle(world.engine, "POST", path, {"amount": 0})[0] == 400
+    assert api.handle(world.engine, "POST", path)[1]["amount"] == 875
+
+
+def test_refunds_take_oldest_payment_first(world):
+    _, invoice = paid_invoice(world)
+    first = world.ctx.store.payments_for_invoice(invoice["id"])[0]
+    second = dict(first, id="pay_extra", amount=200, refunded_amount=0, gateway_ref="ch_extra")
+    world.ctx.store.payments[second["id"]] = second
+    world.gateway._captured_by_ref[second["gateway_ref"]] = 200
+    world.engine.refund(invoice["id"], amount=1100)
+    assert world.gateway.refunds == [(first["gateway_ref"], 1000), (second["gateway_ref"], 100)]
+    assert first["status"] == "refunded"
+    assert second["status"] == "partially_refunded"
+
+
+def test_credit_only_invoice_can_be_refunded_once(world):
+    customer, invoice = paid_invoice(world, credit=1000)
+    assert world.engine.refund(invoice["id"])["amount"] == 1000
+    assert ledger.balance(world.ctx, customer["id"]) == 1000
+    assert world.gateway.refunds == []
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
