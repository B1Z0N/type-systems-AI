 from billing import ledger
 from billing.clock import format_date
+from billing.events import events_of_type
+
+
+def test_missing_payment_method_enters_dunning_and_exhausts_retries(world):
+    cus = world.customer(card=False)
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    assert inv["status"] == "open"
+    assert inv["attempt_count"] == 1
+    assert inv["next_attempt_at"] == inv["finalized_at"] + 86_400
+    assert sub["status"] == "past_due"
+    assert world.ctx.store.payments == {}
+    assert world.gateway.charges == []
+
+    for days, attempts, next_offset in [(1, 2, 3), (2, 3, 7), (4, 4, None)]:
+        world.advance_days(days)
+        assert inv["attempt_count"] == attempts
+        assert inv["next_attempt_at"] == (
+            inv["finalized_at"] + next_offset * 86_400 if next_offset is not None else None
+        )
+
+    failures = events_of_type(world.ctx, "invoice.payment_failed")
+    assert [event["payload"]["attempt"] for event in failures] == [1, 2, 3, 4]
+    assert all(event["payload"]["failure_code"] == "no_payment_method" for event in failures)
+    assert inv["status"] == "open"
+    assert sub["status"] == "unpaid"
+    assert world.ctx.store.payments == {}
+    assert world.gateway.charges == []
 
 
