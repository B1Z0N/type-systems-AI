+def test_metered_usage_is_billed_in_the_period_reported(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    start = sub["current_period_start"]
+    end = sub["current_period_end"]
+    assert world.engine.invoices_for(cus["id"])[0]["lines"] == []
+
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 2, timestamp=start * 1000)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3, timestamp=end * 1000 - 1)
+    world.clock.set(end)
+    [first_renewal] = world.engine.run_cycle()
+    [first_usage_line] = first_renewal["lines"]
+    assert first_usage_line["quantity"] == 5
+    assert first_usage_line["amount"] == 10
+    assert (first_usage_line["period_start"], first_usage_line["period_end"]) == (start, end)
+
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 7, timestamp=end * 1000)
+    world.clock.set(sub["current_period_end"])
+    [second_renewal] = world.engine.run_cycle()
+    [second_usage_line] = second_renewal["lines"]
+    assert second_usage_line["quantity"] == 7
+    assert second_usage_line["amount"] == 14
+
+
