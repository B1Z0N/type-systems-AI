+
+def test_metered_usage_is_billed_in_the_period_it_was_reported(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    start = sub["current_period_start"]
+    end = sub["current_period_end"]
+
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 4, timestamp=to_millis(end) - 1)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 5, timestamp=to_millis(end))
+
+    world.clock.set(end)
+    [first_invoice] = world.engine.run_cycle()
+    [first_line] = first_invoice["lines"]
+    assert first_line["kind"] == "usage"
+    assert first_line["period_start"] == start
+    assert first_line["period_end"] == end
+    assert first_line["quantity"] == 7
+    assert first_invoice["total"] == 14
+
+    world.clock.set(sub["current_period_end"])
+    [second_invoice] = world.engine.run_cycle()
+    assert second_invoice["lines"][0]["quantity"] == 5
+    assert second_invoice["total"] == 10
