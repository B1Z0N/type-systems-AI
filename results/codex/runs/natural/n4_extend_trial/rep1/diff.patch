+def test_extend_trial_delays_billing_and_emits_update(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    original_end = sub["trial_end"]
+
+    assert subscriptions.extend_trial(world.ctx, sub["id"], 3) is sub
+    assert sub["trial_end"] == original_end + 3 * 86_400
+    assert sub["current_period_end"] == sub["trial_end"]
+    [event] = events_of_type(world.ctx, "subscription.updated")
+    assert event["payload"]["subscription"]["current_period_end"] == sub["trial_end"]
+    assert event["payload"]["previous_status"] == "trialing"
+
+    assert world.advance_days(14) == []
+    assert sub["status"] == "trialing"
+    assert world.engine.invoices_for(cus["id"]) == []
+    [invoice] = world.advance_days(3)
+    assert sub["status"] == "active"
+    assert invoice["total"] == 1000
+    assert invoice["status"] == "paid"
+
+
+@pytest.mark.parametrize("days", [0, -1, 1.5, "2", True, None])
+def test_extend_trial_rejects_invalid_days(world, days):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    original_end = sub["trial_end"]
+
+    with pytest.raises(ValidationError):
+        subscriptions.extend_trial(world.ctx, sub["id"], days)
+
+    assert sub["trial_end"] == original_end
+    assert sub["current_period_end"] == original_end
+    assert events_of_type(world.ctx, "subscription.updated") == []
+
+
+def test_extend_trial_requires_trialing_subscription(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    original_end = sub["current_period_end"]
+
+    with pytest.raises(InvalidStateError):
+        subscriptions.extend_trial(world.ctx, sub["id"], 2)
+
+    assert sub["current_period_end"] == original_end
+    assert events_of_type(world.ctx, "subscription.updated") == []
+
