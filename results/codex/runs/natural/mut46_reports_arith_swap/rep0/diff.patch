+def test_mrr_adds_monthly_and_annual_subscriptions(world):
+    monthly_customer = world.customer(email="monthly@example.com")
+    annual_customer = world.customer(email="annual@example.com")
+    annual_price = catalog.create_price(
+        world.ctx, world.plan["id"], "usd", "per_unit", unit_amount=12000, interval="year"
+    )
+    world.engine.subscribe(monthly_customer["id"], [(world.team_monthly["id"], 1)])
+    world.engine.subscribe(annual_customer["id"], [(annual_price["id"], 1)])
+
+    assert reports.mrr(world.ctx) == {"usd": 4000}
