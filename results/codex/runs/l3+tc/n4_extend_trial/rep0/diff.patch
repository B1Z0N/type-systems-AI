+def test_extend_trial_delays_billing_until_extended_end(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=3)
+    original_start = sub["current_period_start"]
+    original_end = sub["trial_end"]
+    assert original_end is not None
+
+    assert subscriptions.extend_trial(world.ctx, sub["id"], 2) is sub
+    assert sub["trial_end"] == original_end + 2 * SECONDS_PER_DAY
+    assert sub["current_period_end"] == sub["trial_end"]
+    assert sub["current_period_start"] == original_start
+    [event] = events_of_type(world.ctx, "subscription.updated")
+    assert event["payload"]["subscription"]["current_period_end"] == sub["trial_end"]
+
+    assert world.advance_days(4) == []
+    assert sub["status"] == "trialing"
+    assert world.engine.invoices_for(cus["id"]) == []
+    [invoice] = world.advance_days(1)
+    assert sub["status"] == "active"
+    assert invoice["status"] == "paid"
+    assert invoice["total"] == 1000
+
+
+@pytest.mark.parametrize("days", [0, -1, True, False, 1.5, "2", None])
+def test_extend_trial_rejects_invalid_days_without_changes(world, days):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=3)
+    original_end = sub["trial_end"]
+
+    with pytest.raises(ValidationError):
+        subscriptions.extend_trial(world.ctx, sub["id"], days)
+    assert sub["trial_end"] == original_end
+    assert sub["current_period_end"] == original_end
+    assert events_of_type(world.ctx, "subscription.updated") == []
+
+
+def test_extend_trial_requires_trialing_subscription(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=1)
+    world.advance_days(1)
+    original_end = sub["current_period_end"]
+
+    with pytest.raises(InvalidStateError):
+        subscriptions.extend_trial(world.ctx, sub["id"], 2)
+    assert sub["current_period_end"] == original_end
+
