+def test_extend_trial_delays_billing_and_emits_update(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    original_end = sub["trial_end"]
+    original_period_end = sub["current_period_end"]
+    assert original_end is not None
+
+    returned = subscriptions.extend_trial(world.ctx, sub["id"], 3)
+    assert returned is sub
+    assert sub["trial_end"] == original_end + 3 * 86_400
+    assert sub["current_period_end"] == original_period_end + 3 * 86_400
+    [event] = events_of_type(world.ctx, "subscription.updated")
+    assert event["payload"]["subscription"]["trial_end"] == sub["trial_end"]
+
+    world.advance_days(14)
+    assert sub["status"] == "trialing"
+    assert world.engine.invoices_for(cus["id"]) == []
+    world.advance_days(3)
+    assert sub["status"] == "active"
+    [invoice] = world.engine.invoices_for(cus["id"])
+    assert invoice["total"] == 1000
+
+
+def test_extend_trial_rejects_invalid_days_and_non_trialing_subscriptions(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)], trial_days=14)
+    original_end = sub["trial_end"]
+    for days in (0, -1, True, 1.5, "2"):
+        with pytest.raises(ValidationError):
+            subscriptions.extend_trial(world.ctx, sub["id"], days)
+    assert sub["trial_end"] == original_end
+    assert events_of_type(world.ctx, "subscription.updated") == []
+
+    world.advance_days(14)
+    with pytest.raises(InvalidStateError):
+        subscriptions.extend_trial(world.ctx, sub["id"], 1)
+
+
