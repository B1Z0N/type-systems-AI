@@ -1,6 +1,9 @@
 import pytest
 
 from billing import ledger, refunds
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
+from billing.models import Cents
 
 
 def test_credit_note_limits(world):
@@ -11,3 +14,78 @@ def test_credit_note_limits(world):
     assert ledger.balance(world.ctx, cus["id"]) == 400
     with pytest.raises(Exception):
         refunds.credit_invoice(world.ctx, inv["id"], 700, "too much")
+
+
+def test_partial_refunds_and_final_remainder(world):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    [payment] = world.ctx.store.payments_for_invoice(inv["id"])
+
+    first = world.engine.refund(inv["id"], amount=Cents(250))
+    second = refunds.refund_invoice(world.ctx, inv["id"], amount=Cents(300))
+    assert [first["amount"], second["amount"]] == [250, 300]
+    assert first["refunded"] and second["refunded"]
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 550
+    with pytest.raises(ValidationError):
+        world.engine.refund(inv["id"], amount=Cents(451))
+    assert payment["refunded_amount"] == 550
+
+    final = world.engine.refund(inv["id"])
+    assert final["amount"] == 450
+    assert payment["status"] == "refunded"
+    assert [amount for _, amount in world.gateway.refunds] == [250, 300, 450]
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+
+
+def test_refund_returns_applied_credit_once_after_partials(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], Cents(700))
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    assert world.engine.refund(inv["id"], amount=Cents(100))["amount"] == 100
+    assert ledger.balance(world.ctx, cus["id"]) == 0
+    assert world.engine.refund(inv["id"])["amount"] == 900
+    assert ledger.balance(world.ctx, cus["id"]) == 700
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(inv["id"])
+    assert ledger.balance(world.ctx, cus["id"]) == 700
+
+
+def test_refund_api_amount_validation(world):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    path = f"/invoices/{inv['id']}/refund"
+    for invalid in (0, -1, 1001, True, "50"):
+        assert handle(world.engine, "POST", path, {"amount": invalid})[0] == 400
+    status, body = handle(world.engine, "POST", path, {"amount": 400})
+    assert status == 200 and body["amount"] == 400
+    status, body = handle(world.engine, "POST", path)
+    assert status == 200 and body["amount"] == 600
+    assert handle(world.engine, "POST", path)[0] == 409
+
+
+def test_refund_uses_oldest_successful_payment_first(world):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+    [newer] = world.ctx.store.payments_for_invoice(inv["id"])
+    newer["amount"] = Cents(400)
+    method = world.ctx.store.require_payment_method(newer["method_id"])
+    charge = world.gateway.charge(method, Cents(600), inv["currency"], "older-payment")
+    assert charge["gateway_ref"] is not None
+    older = newer.copy()
+    older["id"] = world.ctx.ids.payment()
+    older["amount"] = Cents(600)
+    older["gateway_ref"] = charge["gateway_ref"]
+    older["created_at"] = newer["created_at"] - 1
+    world.ctx.store.payments[older["id"]] = older
+
+    note = world.engine.refund(inv["id"], amount=Cents(700))
+    assert note["amount"] == 700
+    assert world.gateway.refunds == [(older["gateway_ref"], 600), (newer["gateway_ref"], 100)]
+    assert older["status"] == "refunded"
+    assert newer["status"] == "partially_refunded"
