@@ -1,6 +1,8 @@
 import pytest
 
 from billing import ledger, refunds
+from billing.api import handle
+from billing.errors import InvalidStateError, ValidationError
 
 
 def test_credit_note_limits(world):
@@ -11,3 +13,67 @@ def test_credit_note_limits(world):
     assert ledger.balance(world.ctx, cus["id"]) == 400
     with pytest.raises(Exception):
         refunds.credit_invoice(world.ctx, inv["id"], 700, "too much")
+
+
+def test_partial_refunds_then_full_refund_restore_credit_once(world):
+    cus = world.customer()
+    ledger.grant_credit(world.ctx, cus["id"], 200)
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(cus["id"])
+    [payment] = world.ctx.store.payments_for_invoice(invoice["id"])
+
+    first = world.engine.refund(invoice["id"], amount=300)
+    second = refunds.refund_invoice(world.ctx, invoice["id"], amount=200)
+    assert [first["amount"], second["amount"]] == [300, 200]
+    assert first["refunded"] and second["refunded"]
+    assert payment["status"] == "partially_refunded"
+    assert payment["refunded_amount"] == 500
+    assert ledger.balance(world.ctx, cus["id"]) == 0
+
+    final = world.engine.refund(invoice["id"])
+    assert final["amount"] == 500  # 300 remaining on the card plus 200 account credit
+    assert payment["status"] == "refunded"
+    assert payment["refunded_amount"] == 800
+    assert [amount for _, amount in world.gateway.refunds] == [300, 200, 300]
+    assert ledger.balance(world.ctx, cus["id"]) == 200
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_amount_validation_and_api(world):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(cus["id"])
+    for amount in (0, -1, 1001):
+        with pytest.raises(ValidationError):
+            world.engine.refund(invoice["id"], amount=amount)
+    assert world.gateway.refunds == []
+
+    path = f"/invoices/{invoice['id']}/refund"
+    assert handle(world.engine, "POST", path, {"amount": True})[0] == 400
+    assert handle(world.engine, "POST", path, {"amount": 1001})[0] == 400
+    status, result = handle(world.engine, "POST", path, {"amount": 400, "reason": "duplicate"})
+    assert status == 200 and result["amount"] == 400
+    assert world.engine.refund(invoice["id"], amount=600)["amount"] == 600
+    with pytest.raises(InvalidStateError):
+        world.engine.refund(invoice["id"])
+
+
+def test_refund_uses_oldest_successful_payment_first(world):
+    cus = world.customer()
+    world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(cus["id"])
+    [older] = world.ctx.store.payments_for_invoice(invoice["id"])
+    method = world.ctx.store.require_payment_method(older["method_id"])
+    charge = world.gateway.charge(method, 400, older["currency"], "additional-payment")
+    newer = older.copy()
+    newer["id"] = world.ctx.ids.payment()
+    newer["amount"] = 400
+    newer["gateway_ref"] = charge["gateway_ref"]
+    newer["created_at"] = older["created_at"] + 1
+    world.ctx.store.payments[newer["id"]] = newer
+
+    world.engine.refund(invoice["id"], amount=1100)
+    assert older["refunded_amount"] == 1000 and older["status"] == "refunded"
+    assert newer["refunded_amount"] == 100 and newer["status"] == "partially_refunded"
+    assert world.gateway.refunds == [(older["gateway_ref"], 1000), (newer["gateway_ref"], 100)]
