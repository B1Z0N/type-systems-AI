diff --git a/tests/test_usage_timestamps.py b/tests/test_usage_timestamps.py
new file mode 100644
index 0000000..9b69c93
--- /dev/null
+++ b/tests/test_usage_timestamps.py
@@ -0,0 +1,84 @@
+from billing import usage
+from billing.api import handle
+from billing.models import EpochMillis, EpochSeconds
+
+
+def test_usage_reporters_accept_milliseconds_and_store_seconds(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    timestamp = EpochMillis((world.clock.now() + 5) * 1000)
+
+    direct = usage.report_usage(world.ctx, subscription["id"], world.api_calls["id"], 2, timestamp)
+    through_engine = world.engine.report_usage(subscription["id"], world.api_calls["id"], 3, timestamp)
+
+    assert direct["timestamp"] == world.clock.now() + 5
+    assert through_engine["timestamp"] == world.clock.now() + 5
+    assert world.ctx.store.usage_records[direct["id"]]["timestamp"] == world.clock.now() + 5
+    assert world.ctx.store.usage_records[through_engine["id"]]["timestamp"] == world.clock.now() + 5
+
+
+def test_usage_api_returns_milliseconds_from_seconds_record(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    timestamp = (world.clock.now() + 5) * 1000
+
+    status, response = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {"subscription": subscription["id"], "price": world.api_calls["id"], "quantity": 3, "timestamp": timestamp},
+    )
+
+    assert status == 201
+    assert response["timestamp"] == timestamp
+    assert world.ctx.store.usage_records[response["id"]]["timestamp"] == world.clock.now() + 5
+
+
+def test_usage_api_preserves_subsecond_timestamp_on_idempotent_retry(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    timestamp = world.clock.now() * 1000 + 123
+    body = {
+        "subscription": subscription["id"],
+        "price": world.api_calls["id"],
+        "quantity": 3,
+        "timestamp": timestamp,
+        "idempotency_key": "same-usage",
+    }
+
+    first = handle(world.engine, "POST", "/usage", body)
+    retry = handle(world.engine, "POST", "/usage", {**body, "timestamp": timestamp + 500})
+
+    assert first[0] == 201
+    assert first[1]["timestamp"] == timestamp
+    assert retry[1]["timestamp"] == timestamp
+    assert retry[1]["id"] == first[1]["id"]
+    assert world.ctx.store.usage_records[first[1]["id"]]["timestamp"] == world.clock.now()
+
+
+def test_usage_period_boundaries_and_last_aggregation_keep_seconds_order(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    start = world.clock.now()
+    end = EpochSeconds(start + 10)
+    price_id = world.api_calls["id"]
+    usage.report_usage(world.ctx, subscription["id"], price_id, 1, EpochMillis((start - 1) * 1000))
+    usage.report_usage(world.ctx, subscription["id"], price_id, 2, EpochMillis(start * 1000))
+    usage.report_usage(world.ctx, subscription["id"], price_id, 3, EpochMillis((end - 1) * 1000))
+    usage.report_usage(world.ctx, subscription["id"], price_id, 4, EpochMillis(end * 1000))
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], price_id, start, end) == 5
+    world.api_calls["usage_aggregation"] = "last"
+    assert usage.aggregate_usage(world.ctx, subscription["id"], price_id, start, end) == 3
+
+
+def test_last_aggregation_uses_millisecond_order_within_second(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    price_id = world.api_calls["id"]
+    start = world.clock.now()
+    world.api_calls["usage_aggregation"] = "last"
+    usage.report_usage(world.ctx, subscription["id"], price_id, 7, EpochMillis(start * 1000 + 900))
+    usage.report_usage(world.ctx, subscription["id"], price_id, 2, EpochMillis(start * 1000 + 100))
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], price_id, start, EpochSeconds(start + 1)) == 7
