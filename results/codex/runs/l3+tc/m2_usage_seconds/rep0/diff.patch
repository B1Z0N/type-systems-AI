diff --git a/tests/test_usage_timestamp.py b/tests/test_usage_timestamp.py
new file mode 100644
index 0000000..7d4ccbb
--- /dev/null
+++ b/tests/test_usage_timestamp.py
@@ -0,0 +1,65 @@
+from billing import catalog, usage
+from billing.api import handle
+from billing.models import EpochMillis
+
+
+def test_usage_records_store_seconds_from_millisecond_inputs(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    milliseconds = EpochMillis(world.clock.now() * 1000 + 731)
+
+    record = usage.report_usage(world.ctx, subscription["id"], world.api_calls["id"], 3, milliseconds)
+    defaulted = world.engine.report_usage(subscription["id"], world.api_calls["id"], 4)
+
+    assert record["timestamp"] == world.clock.now()
+    assert world.ctx.store.usage_records[record["id"]]["timestamp"] == world.clock.now()
+    assert defaulted["timestamp"] == world.clock.now()
+
+
+def test_usage_api_returns_exact_milliseconds_for_new_and_idempotent_records(world):
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(world.api_calls["id"], 0)])
+    body = {
+        "subscription": subscription["id"],
+        "price": world.api_calls["id"],
+        "quantity": 3,
+        "timestamp": world.clock.now() * 1000 + 731,
+        "idempotency_key": "usage-1",
+    }
+
+    status, response = handle(world.engine, "POST", "/usage", body)
+    retry_status, retry_response = handle(world.engine, "POST", "/usage", body)
+
+    assert status == retry_status == 201
+    assert response["timestamp"] == body["timestamp"]
+    assert retry_response == response
+    assert world.ctx.store.usage_records[response["id"]]["timestamp"] == world.clock.now()
+
+    status, default_response = handle(
+        world.engine,
+        "POST",
+        "/usage",
+        {"subscription": subscription["id"], "price": world.api_calls["id"], "quantity": 1},
+    )
+    assert status == 201
+    assert default_response["timestamp"] == world.clock.now() * 1000
+
+
+def test_usage_billing_preserves_period_boundaries_and_millisecond_last_order(world):
+    price = catalog.create_price(
+        world.ctx, world.api["id"], "usd", "metered", unit_amount=2, usage_aggregation="last"
+    )
+    customer = world.customer()
+    subscription = world.engine.subscribe(customer["id"], [(price["id"], 0)])
+    start = subscription["current_period_start"]
+    end = subscription["current_period_end"]
+
+    world.engine.report_usage(subscription["id"], price["id"], 99, EpochMillis(start * 1000 - 1))
+    world.engine.report_usage(subscription["id"], price["id"], 11, EpochMillis(end * 1000 - 1))
+    world.engine.report_usage(subscription["id"], price["id"], 7, EpochMillis(end * 1000 - 900))
+    world.engine.report_usage(subscription["id"], price["id"], 88, EpochMillis(end * 1000))
+
+    assert usage.aggregate_usage(world.ctx, subscription["id"], price["id"], start, end) == 11
+    world.clock.set(end)
+    [invoice] = world.engine.run_cycle()
+    assert invoice["total"] == 22
