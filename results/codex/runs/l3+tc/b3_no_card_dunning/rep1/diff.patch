+def test_no_payment_method_enters_dunning_and_exhausts_retries(world):
+    cus = world.customer(card=False)
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    assert inv["status"] == "open"
+    assert inv["attempt_count"] == 1
+    assert inv["next_attempt_at"] == inv["finalized_at"] + SECONDS_PER_DAY
+    assert sub["status"] == "past_due"
+    assert world.ctx.store.payments == {}
+
+    for days, attempt, next_offset in [(1, 2, 3), (2, 3, 7)]:
+        world.advance_days(days)
+        assert inv["attempt_count"] == attempt
+        assert inv["next_attempt_at"] == inv["finalized_at"] + next_offset * SECONDS_PER_DAY
+        assert sub["status"] == "past_due"
+
+    world.advance_days(4)
+    assert inv["attempt_count"] == 4
+    assert inv["next_attempt_at"] is None
+    assert inv["status"] == "open"
+    assert sub["status"] == "unpaid"
+    assert world.ctx.store.payments == {}
+    failures = events.events_of_type(world.ctx, "invoice.payment_failed")
+    assert [(event["payload"]["failure_code"], event["payload"]["attempt"]) for event in failures] == [
+        ("no_payment_method", attempt) for attempt in range(1, 5)
+    ]
