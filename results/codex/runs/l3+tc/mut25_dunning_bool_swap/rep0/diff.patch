+
+def test_declined_card_retries_only_on_dunning_schedule(world):
+    cus = world.customer(last4="0002")
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [invoice] = world.engine.invoices_for(cus["id"])
+    first_attempt_at = world.clock.now()
+
+    assert invoice["attempt_count"] == 1
+    assert invoice["next_attempt_at"] == first_attempt_at + SECONDS_PER_DAY
+    assert sub["status"] == "past_due"
+
+    for day in range(8):
+        world.engine.run_cycle()
+        assert invoice["attempt_count"] == 1 + sum(retry_day <= day for retry_day in (1, 3, 7))
+        if day < 7:
+            assert sub["status"] == "past_due"
+        else:
+            assert sub["status"] == "unpaid"
+            assert invoice["next_attempt_at"] is None
+        if day < 7:
+            world.clock.advance_days(1)
+
+    world.engine.run_cycle()
+    assert invoice["attempt_count"] == 4
+    assert len(world.gateway.charges) == 4
