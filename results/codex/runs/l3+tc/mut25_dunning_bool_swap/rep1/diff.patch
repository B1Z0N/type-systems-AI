diff --git a/tests/test_lifecycle.py b/tests/test_lifecycle.py
index 0a2eb09..74c629f 100644
--- a/tests/test_lifecycle.py
+++ b/tests/test_lifecycle.py
@@ -55,3 +55,25 @@ def test_credit_applied_on_finalize(world):
     assert inv["credit_applied"] == 700
     assert inv["amount_paid"] == 300
     assert ledger.balance(world.ctx, cus["id"]) == 0
+
+
+def test_declined_card_retries_only_on_dunning_schedule(world):
+    cus = world.customer(last4="0002")
+    sub = world.engine.subscribe(cus["id"], [(world.monthly["id"], 1)])
+    [inv] = world.engine.invoices_for(cus["id"])
+
+    assert inv["attempt_count"] == 1
+    assert len(world.gateway.charges) == 1
+    assert sub["status"] == "past_due"
+
+    for day in range(1, 9):
+        world.advance_days(1)
+        expected = 1 + sum(day >= offset for offset in (1, 3, 7))
+        assert inv["attempt_count"] == expected
+        assert len(world.gateway.charges) == expected
+        assert sub["status"] == ("unpaid" if day >= 7 else "past_due")
+
+    assert inv["next_attempt_at"] is None
+    world.advance_days(1)
+    assert inv["attempt_count"] == 4
+    assert len(world.gateway.charges) == 4
