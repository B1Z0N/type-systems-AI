diff --git a/tests/test_lifecycle.py b/tests/test_lifecycle.py
index 0a2eb09..e960ec2 100644
--- a/tests/test_lifecycle.py
+++ b/tests/test_lifecycle.py
@@ -55,3 +55,22 @@ def test_credit_applied_on_finalize(world):
     assert inv["credit_applied"] == 700
     assert inv["amount_paid"] == 300
     assert ledger.balance(world.ctx, cus["id"]) == 0
+
+
+def test_metered_renewal_bills_usage_in_its_period(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    start = sub["current_period_start"]
+    end = sub["current_period_end"]
+
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3, start * 1000)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 4, end * 1000 - 1)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 10, end * 1000)
+
+    world.clock.set(end)
+    [first] = world.engine.run_cycle()
+    assert [(line["quantity"], line["amount"]) for line in first["lines"]] == [(7, 14)]
+
+    world.clock.set(sub["current_period_end"])
+    [second] = world.engine.run_cycle()
+    assert [(line["quantity"], line["amount"]) for line in second["lines"]] == [(10, 20)]
