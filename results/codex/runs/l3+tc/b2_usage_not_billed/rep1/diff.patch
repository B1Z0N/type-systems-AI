+def test_metered_usage_is_billed_in_the_period_reported(world):
+    cus = world.customer()
+    sub = world.engine.subscribe(cus["id"], [(world.api_calls["id"], 0)])
+    start = sub["current_period_start"]
+    end = sub["current_period_end"]
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 2, timestamp=start * 1000)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 3, timestamp=end * 1000 - 1)
+    world.engine.report_usage(sub["id"], world.api_calls["id"], 7, timestamp=end * 1000)
+
+    [first] = world.advance_days(31)
+    [line] = first["lines"]
+    assert line["kind"] == "usage"
+    assert line["quantity"] == 5
+    assert line["amount"] == 10
+    assert line["period_start"] == start
+    assert line["period_end"] == end
+
+    [second] = world.advance_days(28)
+    assert second["lines"][0]["quantity"] == 7
+    assert second["total"] == 14
+
+
