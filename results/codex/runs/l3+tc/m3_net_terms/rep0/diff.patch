+def test_customer_net_terms_apply_at_finalization(world):
+    cus = customers.create_customer(world.ctx, "terms@example.com", "Terms", net_terms_days=14)
+    assert cus["net_terms_days"] == 14
+    first = invoices.create_one_off(world.ctx, cus["id"], [("Service", 1000, 1)])
+    finalized = invoices.finalize(world.ctx, first["id"])
+    assert finalized["due_at"] == finalized["finalized_at"] + 14 * 86_400
+
+    draft = invoices.create_one_off(world.ctx, cus["id"], [("Service", 1000, 1)])
+    customers.update_customer(world.ctx, cus["id"], net_terms_days=0)
+    finalized_draft = invoices.finalize(world.ctx, draft["id"])
+    assert finalized_draft["due_at"] == finalized_draft["finalized_at"]
+    assert finalized["due_at"] == finalized["finalized_at"] + 14 * 86_400
+
+
+def test_customer_net_terms_validation(world):
+    cus = world.customer()
+    assert cus["net_terms_days"] == 7
+    with pytest.raises(ValidationError):
+        customers.create_customer(world.ctx, "bad@example.com", "Bad", net_terms_days=-1)
+    with pytest.raises(ValidationError):
+        customers.update_customer(world.ctx, cus["id"], net_terms_days=-1)
+    assert cus["net_terms_days"] == 7
